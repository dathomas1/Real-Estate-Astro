---
import PageLayout from '@layouts/PageLayout.astro';
import TestimonialCard from '@components/ui/TestimonialCard.astro';
import Button from '@components/ui/Button.astro';
import { siteConfig } from '@data/site';
import { getCollection } from 'astro:content';

// Fetch all entries from the testimonials collection
const testimonials = await getCollection('testimonials');

// Google Business Profile review placeholder URL per specification
const googleReviewPlaceholderUrl =
  'https://search.google.com/local/writereview?placeid=[PLACEHOLDER_GBP_ID_ALYZON_THOMAS]';

// Page 4: Testimonials Schema Stack — Strictly BreadcrumbList only (NO AggregateRating schema per CRO guide)
const testimonialsSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${siteConfig.domain}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Client Reviews & Testimonials',
      item: `${siteConfig.domain}/testimonials/`,
    },
  ],
};
---

<PageLayout
  title="Client Reviews & Testimonials | Alyson Thomas Sebring FL"
  description="Read real client reviews and testimonials for Alyson Thomas, licensed real estate agent in Sebring, FL. See how Alyson helps Highlands County homeowners sell successfully."
  canonicalUrl={`${siteConfig.domain}/testimonials/`}
  schema={testimonialsSchema}
>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-stone-100 border-b border-stone-200 py-3 px-4 sm:px-6" aria-label="Breadcrumb">
    <div class="max-w-6xl mx-auto flex items-center space-x-2 text-xs sm:text-sm text-stone-600">
      <a href="/" class="hover:text-[#1b3a5c] hover:underline">Home</a>
      <span aria-hidden="true" class="text-stone-400">/</span>
      <span class="text-stone-900 font-semibold" aria-current="page">Client Reviews & Testimonials</span>
    </div>
  </nav>

  <main class="py-12 sm:py-16 px-4 sm:px-6">
    <div class="max-w-6xl mx-auto">
      <!-- Page Header -->
      <header class="max-w-3xl mb-12">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-100 text-amber-900 border border-amber-300 mb-4">
          Client Feedback & Experiences
        </span>
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-[#1b3a5c] tracking-tight mb-4">
          Client Reviews & Testimonials
        </h1>
        <p class="text-base sm:text-lg text-stone-700 leading-relaxed font-sans">
          Selling a home is one of life's most significant financial and personal transitions. Discover how Alyson Thomas delivers neighborhood-level pricing strategy, attentive communication, and seamless closings for homeowners throughout Sebring and Highlands County.
        </p>
      </header>

      <!-- Google Business Profile Review Strip -->
      <div class="bg-white rounded-2xl p-6 sm:p-7 border border-stone-200 shadow-sm mb-12 flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center text-2xl font-bold shrink-0">
            ⭐
          </div>
          <div>
            <h2 class="font-serif text-lg sm:text-xl font-bold text-[#1b3a5c]">
              Worked With Alyson Recently?
            </h2>
            <p class="text-xs sm:text-sm text-stone-600 mt-0.5">
              Your feedback helps future Highlands County buyers and sellers make informed decisions.
            </p>
          </div>
        </div>

        <div class="shrink-0 w-full md:w-auto text-center">
          <a
            href={googleReviewPlaceholderUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-5 py-3 rounded-lg font-bold text-[#1b3a5c] bg-stone-100 hover:bg-stone-200 border border-stone-300 transition-colors text-sm w-full md:w-auto"
            aria-label="Leave a review on Google Business Profile (opens in a new tab)"
          >
            <span>Leave a Google Review</span>
            <span class="ml-1.5" aria-hidden="true">↗</span>
          </a>
          <span class="block text-[10px] text-stone-400 mt-1">
            [Placeholder URL: {googleReviewPlaceholderUrl}]
          </span>
        </div>
      </div>

      <!-- Testimonials Grid: Pulling all entries from the collection -->
      <section aria-label="Client Testimonials Collection" class="mb-16">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
          {testimonials.map((item) => (
            <TestimonialCard
              quote={item.data.quote}
              clientName={item.data.clientName}
              neighborhood={item.data.neighborhood}
              year={item.data.year}
              isPlaceholder={item.data.isPlaceholder}
            />
          ))}
        </div>

        <p class="text-xs text-stone-500 text-center mt-6 italic">
          * Note: Reviews shown above represent structured sample formats reflecting typical client outcomes across Sebring neighborhoods. Real client testimonials will be populated as transactions close and Google reviews accumulate.
        </p>
      </section>

      <!-- Seller Commitment Value Statement -->
      <section class="mb-16 bg-stone-50 rounded-2xl p-8 sm:p-10 border border-stone-200">
        <div class="max-w-3xl">
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#1b3a5c] mb-4">
            The Alyson Thomas Standard
          </h2>
          <p class="text-stone-700 text-base leading-relaxed mb-4">
            Every seller's circumstances are distinct. Whether dealing with an estate probate sale, coordinating an out-of-state retirement relocation, or simply capitalizing on built-up equity, you receive direct representation.
          </p>
          <ul class="space-y-2.5 text-sm sm:text-base text-stone-700">
            <li class="flex items-start gap-2">
              <span class="text-amber-700 font-bold" aria-hidden="true">✓</span>
              <span><strong>Uncompromising Communication:</strong> Consistent weekly updates and immediate feedback after every private showing or open house.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-700 font-bold" aria-hidden="true">✓</span>
              <span><strong>Data-Driven Pricing:</strong> Comparative market analyses built on verified local neighborhood comps rather than speculative estimates.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-700 font-bold" aria-hidden="true">✓</span>
              <span><strong>Fiduciary Protection:</strong> Skillful negotiation on inspection items, financing contingencies, and appraisal terms to protect your net proceeds.</span>
            </li>
          </ul>
        </div>
      </section>

      <!-- Final Call to Action Section -->
      <section class="bg-[#1b3a5c] rounded-2xl p-8 sm:p-12 text-white text-center shadow-xl">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold mb-4">
          Thinking of Selling? Let's Talk
        </h2>
        <p class="text-stone-200 text-base sm:text-lg max-w-2xl mx-auto mb-8 leading-relaxed font-sans">
          Curious about your home's current market value? Request a complimentary, no-obligation valuation report tailored specifically to your neighborhood's recent sales.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <Button href="/free-home-valuation/" variant="primary" size="lg">
            Get Your Free Home Valuation →
          </Button>
          <a
            href={`tel:${siteConfig.phone}`}
            class="inline-flex items-center justify-center px-6 py-4 rounded-md font-bold text-white border-2 border-white/80 hover:border-white hover:bg-white/10 transition-all text-base min-h-[56px]"
            aria-label={`Call Alyson Thomas directly at ${siteConfig.phoneDisplay}`}
          >
            📞 Call {siteConfig.phoneDisplay}
          </a>
        </div>
      </section>
    </div>
  </main>
</PageLayout>
