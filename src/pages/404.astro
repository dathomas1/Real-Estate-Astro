---
import { Image } from 'astro:assets';
import PageLayout from '@layouts/PageLayout.astro';
import Button from '@components/ui/Button.astro';
import { siteConfig } from '@data/site';
import { agentPortraitPlaceholder } from '@data/placeholderImages';

export const prerender = true;
---

<PageLayout
  title="Page Not Found"
  description="Looks like this page has moved or is no longer available. Explore Sebring homes, seller resources, or contact Alyson Thomas directly."
  noindex={true}
>
  <div class="py-16 sm:py-24 bg-[#faf7f2] min-h-[75vh] flex items-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
      <div class="bg-white rounded-3xl border border-stone-200/80 shadow-lg p-8 sm:p-12 lg:p-16">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-12 items-center">
          
          <!-- Column 1: Alyson Photo Placeholder & Agent Badge -->
          <div class="md:col-span-5 flex flex-col items-center">
            <div class="w-full max-w-[260px] bg-stone-50 rounded-2xl border-2 border-dashed border-amber-400/70 p-4 shadow-sm text-center">
              <div class="aspect-[4/5] rounded-xl overflow-hidden border border-stone-300 shadow-inner bg-stone-100">
                <Image
                  src={agentPortraitPlaceholder.image}
                  alt="Alyson Thomas offering assistance finding homes and real estate guidance in Sebring, Florida"
                  width={800}
                  height={1000}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover"
                />
              </div>
              <div class="mt-3 py-1.5 px-3 bg-white rounded-lg text-xs text-stone-600 font-medium border border-stone-200">
                Here to help you find your way
              </div>
            </div>
          </div>

          <!-- Column 2: Warm Error Messaging & Actions -->
          <div class="md:col-span-7 space-y-6 text-left">
            <div>
              <span class="inline-block px-3 py-1 bg-stone-100 text-[#1b3a5c] rounded-full text-xs font-bold uppercase tracking-widest mb-3">
                Error 404
              </span>
              <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-[#1b3a5c] leading-tight mb-3">
                Looks like this page has moved.
              </h1>
              <p class="text-stone-600 text-base sm:text-lg leading-relaxed">
                Whether you took an unexpected turn or a property listing was recently updated, we can help you get right back on track.
              </p>
            </div>

            <!-- Primary Action Buttons -->
            <div class="flex flex-col sm:flex-row gap-3 pt-2">
              <Button href="/" variant="primary" size="md">
                Return to Homepage
              </Button>
              <Button href="/sell-my-home-sebring-fl/" variant="secondary" size="md">
                Sell My Home in Sebring
              </Button>
            </div>

            <!-- Quick Exploration Links -->
            <div class="pt-4 border-t border-stone-100">
              <p class="text-xs font-bold text-stone-400 uppercase tracking-wider mb-3">
                Or explore popular resources:
              </p>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm">
                <a
                  href="/free-home-valuation/"
                  class="flex items-center text-[#1b3a5c] hover:text-[#d4923a] font-semibold transition-colors py-1"
                >
                  <span class="text-amber-500 mr-2">→</span> Free Home Valuation
                </a>
                <a
                  href="/sebring-neighborhoods/"
                  class="flex items-center text-[#1b3a5c] hover:text-[#d4923a] font-semibold transition-colors py-1"
                >
                  <span class="text-amber-500 mr-2">→</span> Sebring Neighborhoods
                </a>
                <a
                  href="/highlands-county-real-estate-market/"
                  class="flex items-center text-[#1b3a5c] hover:text-[#d4923a] font-semibold transition-colors py-1"
                >
                  <span class="text-amber-500 mr-2">→</span> Market Intelligence
                </a>
                <a
                  href="/contact/"
                  class="flex items-center text-[#1b3a5c] hover:text-[#d4923a] font-semibold transition-colors py-1"
                >
                  <span class="text-amber-500 mr-2">→</span> Contact Alyson Direct
                </a>
              </div>
            </div>

            <!-- Warm Direct Contact Note -->
            <div class="bg-stone-50 rounded-xl p-4 border border-stone-200 text-xs sm:text-sm text-stone-600">
              Looking for a specific property or market question? Call or text Alyson directly at{' '}
              <a
                href={`tel:${siteConfig.phone}`}
                class="font-bold text-[#1b3a5c] hover:text-[#d4923a] underline"
              >
                {siteConfig.phoneDisplay}
              </a>
              .
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>
</PageLayout>
