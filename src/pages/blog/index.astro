---
import PageLayout from '@layouts/PageLayout.astro';
import Button from '@components/ui/Button.astro';
import { siteConfig } from '@data/site';
import { getCollection } from 'astro:content';

// Fetch all entries from the blog collection
const allPosts = await getCollection('blog');
const publishedPosts = allPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());

const sellerEducationPosts = publishedPosts.filter((p) => p.data.contentType === 'Seller Education');
const marketIntelPosts = publishedPosts.filter((p) => p.data.contentType === 'Market Intelligence');
const communityPosts = publishedPosts.filter((p) => p.data.contentType === 'Community/Authority');

// BreadcrumbList schema
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${siteConfig.domain}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Blog & Market Updates',
      item: `${siteConfig.domain}/blog/`,
    },
  ],
};
---

<PageLayout
  title="Sebring Real Estate Blog & Market Insights | Alyson Thomas"
  description="Highlands County real estate guides, seller education, quarterly market intelligence, and community profiles from Alyson Thomas of Premier Plus Realty in Sebring, FL."
  canonicalUrl={`${siteConfig.domain}/blog/`}
  schema={pageSchema}
>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-stone-100 border-b border-stone-200 py-3 px-4 sm:px-6" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center space-x-2 text-xs sm:text-sm text-stone-600">
      <a href="/" class="hover:text-[#1b3a5c] hover:underline">Home</a>
      <span aria-hidden="true" class="text-stone-400">/</span>
      <span class="text-stone-900 font-semibold" aria-current="page">Blog & Market Updates</span>
    </div>
  </nav>

  <main class="py-12 sm:py-16 px-4 sm:px-6 font-sans">
    <div class="max-w-6xl mx-auto">
      <!-- Header -->
      <header class="mb-12 text-center max-w-3xl mx-auto">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-100 text-amber-900 border border-amber-300 mb-3">
          Local Insights & Seller Advisory
        </span>
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-[#1b3a5c] tracking-tight mb-4 leading-tight">
          Highlands County Real Estate Journal
        </h1>
        <p class="text-base sm:text-lg text-stone-600 leading-relaxed">
          Forensic pricing analysis, Florida 4-Point inspection guidance, and localized neighborhood intelligence across Sebring, Avon Park, and Lake Placid.
        </p>
      </header>

      <!-- Content Type Filters / Category Overview -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-12">
        <div class="p-5 bg-stone-50 rounded-xl border border-stone-200 shadow-xs">
          <span class="text-xs font-bold uppercase tracking-wider text-amber-900 block mb-1">Pillar Category</span>
          <h2 class="font-serif text-lg font-bold text-[#1b3a5c] mb-1.5">Seller Education</h2>
          <p class="text-xs text-stone-600 leading-relaxed">
            Florida 4-Point prep, roof age strategies, staging, closing costs, and equity protection.
          </p>
          <span class="text-xs font-semibold text-stone-400 mt-2 block">
            {sellerEducationPosts.length} Articles
          </span>
        </div>

        <div class="p-5 bg-stone-50 rounded-xl border border-stone-200 shadow-xs">
          <span class="text-xs font-bold uppercase tracking-wider text-sky-900 block mb-1">Pillar Category</span>
          <h2 class="font-serif text-lg font-bold text-[#1b3a5c] mb-1.5">Market Intelligence</h2>
          <p class="text-xs text-stone-600 leading-relaxed">
            Quarterly MLS closed benchmarks, inventory absorption, interest rate effects, and DOM velocity.
          </p>
          <span class="text-xs font-semibold text-stone-400 mt-2 block">
            {marketIntelPosts.length} Articles
          </span>
        </div>

        <div class="p-5 bg-stone-50 rounded-xl border border-stone-200 shadow-xs">
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-900 block mb-1">Pillar Category</span>
          <h2 class="font-serif text-lg font-bold text-[#1b3a5c] mb-1.5">Community & Authority</h2>
          <p class="text-xs text-stone-600 leading-relaxed">
            Deep-dive community spotlights across Sebring, Avon Park, Lake Placid, and lakefront lifestyle.
          </p>
          <span class="text-xs font-semibold text-stone-400 mt-2 block">
            {communityPosts.length} Articles
          </span>
        </div>
      </div>

      <!-- Graceful Empty State (renders when collection is empty) -->
      {publishedPosts.length === 0 ? (
        <section class="p-8 sm:p-12 bg-stone-50 rounded-2xl border border-stone-200 text-center max-w-3xl mx-auto shadow-sm my-8" aria-label="Editorial Notice">
          <div class="w-16 h-16 rounded-2xl bg-amber-100 text-amber-900 mx-auto flex items-center justify-center text-3xl mb-4 shadow-xs" aria-hidden="true">
            📰
          </div>
          <span class="text-xs font-bold uppercase tracking-wider text-amber-900 bg-amber-200/60 px-3 py-1 rounded-full border border-amber-300">
            Editorial Pipeline in Production
          </span>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#1b3a5c] mt-4 mb-3">
            New Articles & Market Reports Publishing Soon
          </h2>
          <p class="text-sm sm:text-base text-stone-600 max-w-xl mx-auto leading-relaxed mb-6">
            Our editorial calendar is currently in active production. In-depth seller guides, seasonal snowbird analyses, and quarterly Highlands County housing benchmarks will be released on an ongoing basis.
          </p>

          <div class="p-6 bg-white rounded-xl border border-stone-200 text-left max-w-xl mx-auto mb-8 shadow-xs">
            <h3 class="font-serif text-base font-bold text-[#1b3a5c] mb-2">
              In the Meantime, Explore Our Complete Guides:
            </h3>
            <ul class="space-y-2.5 text-xs sm:text-sm">
              <li>
                <a href="/sell-my-home-sebring-fl/" class="text-[#1b3a5c] font-bold hover:underline flex items-center justify-between">
                  <span>• Sell My Home in Sebring (5-Step Roadmap)</span>
                  <span class="text-stone-400">→</span>
                </a>
              </li>
              <li>
                <a href="/home-selling-guide-highlands-county/" class="text-[#1b3a5c] font-bold hover:underline flex items-center justify-between">
                  <span>• Highlands County Home Selling Guide (10-Step Blueprint)</span>
                  <span class="text-stone-400">→</span>
                </a>
              </li>
              <li>
                <a href="/highlands-county-real-estate-market/" class="text-[#1b3a5c] font-bold hover:underline flex items-center justify-between">
                  <span>• Highlands County Real Estate Market Report</span>
                  <span class="text-stone-400">→</span>
                </a>
              </li>
              <li>
                <a href="/free-home-valuation/" class="text-[#1b3a5c] font-bold hover:underline flex items-center justify-between">
                  <span>• Request a Free Handcrafted Home Valuation</span>
                  <span class="text-stone-400">→</span>
                </a>
              </li>
            </ul>
          </div>

          <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <Button href="/free-home-valuation/" variant="primary" size="md">
              Request Free Home Valuation →
            </Button>
            <a
              href={`tel:${siteConfig.phone}`}
              class="px-5 py-2.5 rounded-lg border border-stone-300 text-[#1b3a5c] font-bold text-xs sm:text-sm hover:bg-white transition-colors"
            >
              Call Alyson: {siteConfig.phoneDisplay}
            </a>
          </div>
        </section>
      ) : (
        <div class="space-y-12">
          {sellerEducationPosts.length > 0 && (
            <section aria-labelledby="seller-edu-heading">
              <h2 id="seller-edu-heading" class="font-serif text-2xl font-bold text-[#1b3a5c] mb-6 pb-2 border-b border-stone-200">
                Seller Education Guides
              </h2>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {sellerEducationPosts.map((post) => (
                  <article class="p-6 bg-white rounded-xl border border-stone-200 shadow-sm flex flex-col justify-between hover:border-[#1b3a5c] transition-colors">
                    <div>
                      <span class="text-xs font-bold text-amber-900 bg-amber-50 px-2.5 py-0.5 rounded-full border border-amber-200 mb-2 inline-block">
                        {post.data.contentType}
                      </span>
                      <h3 class="font-serif text-lg font-bold text-[#1b3a5c] mb-2 leading-snug">
                        <a href={`/blog/${post.data.slug || post.id.replace(/\.[^/.]+$/, '')}/`} class="hover:underline">
                          {post.data.title}
                        </a>
                      </h3>
                      <p class="text-xs sm:text-sm text-stone-600 line-clamp-3 mb-4">
                        {post.data.metaDescription}
                      </p>
                    </div>
                    <div class="pt-4 border-t border-stone-100 flex items-center justify-between text-xs text-stone-500">
                      <time datetime={new Date(post.data.publishDate).toISOString()}>
                        {new Date(post.data.publishDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                      </time>
                      <a href={`/blog/${post.data.slug || post.id.replace(/\.[^/.]+$/, '')}/`} class="font-bold text-[#1b3a5c] hover:underline">
                        Read Article →
                      </a>
                    </div>
                  </article>
                ))}
              </div>
            </section>
          )}

          {marketIntelPosts.length > 0 && (
            <section aria-labelledby="market-intel-heading">
              <h2 id="market-intel-heading" class="font-serif text-2xl font-bold text-[#1b3a5c] mb-6 pb-2 border-b border-stone-200">
                Market Intelligence Reports
              </h2>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {marketIntelPosts.map((post) => (
                  <article class="p-6 bg-white rounded-xl border border-stone-200 shadow-sm flex flex-col justify-between hover:border-[#1b3a5c] transition-colors">
                    <div>
                      <span class="text-xs font-bold text-sky-900 bg-sky-50 px-2.5 py-0.5 rounded-full border border-sky-200 mb-2 inline-block">
                        {post.data.contentType}
                      </span>
                      <h3 class="font-serif text-lg font-bold text-[#1b3a5c] mb-2 leading-snug">
                        <a href={`/blog/${post.data.slug || post.id.replace(/\.[^/.]+$/, '')}/`} class="hover:underline">
                          {post.data.title}
                        </a>
                      </h3>
                      <p class="text-xs sm:text-sm text-stone-600 line-clamp-3 mb-4">
                        {post.data.metaDescription}
                      </p>
                    </div>
                    <div class="pt-4 border-t border-stone-100 flex items-center justify-between text-xs text-stone-500">
                      <time datetime={new Date(post.data.publishDate).toISOString()}>
                        {new Date(post.data.publishDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                      </time>
                      <a href={`/blog/${post.data.slug || post.id.replace(/\.[^/.]+$/, '')}/`} class="font-bold text-[#1b3a5c] hover:underline">
                        Read Report →
                      </a>
                    </div>
                  </article>
                ))}
              </div>
            </section>
          )}

          {communityPosts.length > 0 && (
            <section aria-labelledby="community-heading">
              <h2 id="community-heading" class="font-serif text-2xl font-bold text-[#1b3a5c] mb-6 pb-2 border-b border-stone-200">
                Community & Authority Spotlights
              </h2>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {communityPosts.map((post) => (
                  <article class="p-6 bg-white rounded-xl border border-stone-200 shadow-sm flex flex-col justify-between hover:border-[#1b3a5c] transition-colors">
                    <div>
                      <span class="text-xs font-bold text-emerald-900 bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-200 mb-2 inline-block">
                        {post.data.contentType}
                      </span>
                      <h3 class="font-serif text-lg font-bold text-[#1b3a5c] mb-2 leading-snug">
                        <a href={`/blog/${post.data.slug || post.id.replace(/\.[^/.]+$/, '')}/`} class="hover:underline">
                          {post.data.title}
                        </a>
                      </h3>
                      <p class="text-xs sm:text-sm text-stone-600 line-clamp-3 mb-4">
                        {post.data.metaDescription}
                      </p>
                    </div>
                    <div class="pt-4 border-t border-stone-100 flex items-center justify-between text-xs text-stone-500">
                      <time datetime={new Date(post.data.publishDate).toISOString()}>
                        {new Date(post.data.publishDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                      </time>
                      <a href={`/blog/${post.data.slug || post.id.replace(/\.[^/.]+$/, '')}/`} class="font-bold text-[#1b3a5c] hover:underline">
                        Read Spotlight →
                      </a>
                    </div>
                  </article>
                ))}
              </div>
            </section>
          )}
        </div>
      )}

      <!-- Bottom Advisory Banner -->
      <div class="mt-14 p-6 sm:p-8 bg-[#1b3a5c] text-white rounded-2xl text-center">
        <h2 class="font-serif text-2xl font-bold mb-2">Have a Specific Real Estate Question?</h2>
        <p class="text-xs sm:text-sm text-stone-200 max-w-lg mx-auto mb-5">
          Whether you have questions about Florida 4-Point inspection rules or recent neighborhood closing values, Alyson Thomas is ready to assist.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href="/contact/"
            class="px-6 py-2.5 rounded-lg bg-amber-500 text-stone-950 font-bold text-sm hover:bg-amber-400 transition-colors"
          >
            Ask a Question
          </a>
          <a
            href="/free-home-valuation/"
            class="px-6 py-2.5 rounded-lg border border-white/40 text-white font-bold text-sm hover:bg-white/10 transition-colors"
          >
            Get Free Home Valuation
          </a>
        </div>
      </div>
    </div>
  </main>
</PageLayout>
