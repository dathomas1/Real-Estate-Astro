---
import PageLayout from '@layouts/PageLayout.astro';
import FAQAccordion from '@components/sections/FAQAccordion.astro';
import Button from '@components/ui/Button.astro';
import { siteConfig, siteData } from '@data/site';
import { getCollection } from 'astro:content';

/*
  ==============================================================================
  EVERGREEN CONTENT REFRESH NOTICE:
  Per the Content Strategy's evergreen maintenance schedule, this county-wide
  market trends page requires quarterly updates (Q1, Q2, Q3, Q4).
  Key metrics to refresh each quarter using closed Highlands County MLS data:
  - County-wide median sales price & sub-market breakdown (Sebring, Avon Park, Lake Placid)
  - Average and median Days on Market (DOM)
  - Active listing inventory and months of remaining supply
  - Closed sales volume & percentage of all-cash transactions
  - Prevailing mortgage rate context and local lending trends
  ==============================================================================
*/

// 1. Fetch market-related FAQs
const allFaqs = await getCollection('faq');
const marketQuestions = [
  'Is the Highlands County, FL real estate market currently favoring buyers or sellers?',
  'How do mortgage interest rates affect the Highlands County real estate market?',
  'What is the median home price in Sebring, FL?',
  'What is the hardest month to sell a house in Sebring, FL?',
  'What should you not do before selling your house in Sebring, FL?',
];

const selectedFaqs = allFaqs.filter((f) =>
  marketQuestions.some(
    (q) => f.data.question.toLowerCase().includes(q.toLowerCase()) ||
           q.toLowerCase().includes(f.data.question.toLowerCase())
  )
);

const finalFaqs = selectedFaqs.length >= 3 ? selectedFaqs : allFaqs.slice(0, 5);

const faqAccordionItems = finalFaqs.map((item) => ({
  question: item.data.question,
  answer: item.data.answer,
}));

// 2. Structured Data: BreadcrumbList + FAQPage + RealEstateAgent
const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: `${siteConfig.domain}/`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Highlands County Communities',
          item: `${siteConfig.domain}/sebring-neighborhoods/`,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: 'Highlands County Real Estate Market',
          item: `${siteConfig.domain}/highlands-county-real-estate-market/`,
        },
      ],
    },
    {
      '@type': 'RealEstateAgent',
      '@id': `${siteConfig.domain}/#agent`,
      name: siteConfig.businessName,
      url: `${siteConfig.domain}/highlands-county-real-estate-market/`,
      telephone: siteConfig.phone,
      image: `${siteConfig.domain}/social-preview-image.png`,
      priceRange: '$$',
      address: {
        '@type': 'PostalAddress',
        addressLocality: siteConfig.address.locality,
        addressRegion: siteConfig.address.region,
        postalCode: siteConfig.address.postalCode,
        addressCountry: siteConfig.address.country,
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: siteData.geo.latitude,
        longitude: siteData.geo.longitude,
      },
      areaServed: [
        { '@type': 'AdministrativeArea', name: 'Highlands County' },
        { '@type': 'City', name: 'Sebring' },
        { '@type': 'City', name: 'Avon Park' },
        { '@type': 'City', name: 'Lake Placid' },
      ],
      parentOrganization: {
        '@type': 'Organization',
        name: siteConfig.brokerage,
        url: siteConfig.domain,
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: finalFaqs.map((f) => ({
        '@type': 'Question',
        name: f.data.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: f.data.answer,
        },
      })),
    },
  ],
};
---

<PageLayout
  title="Highlands County Real Estate Market Report | Trends & Pricing Insights"
  description="Comprehensive Highlands County, FL real estate market report: median prices, inventory levels, days on market, and strategic guidance across Sebring, Avon Park, and Lake Placid."
  canonicalUrl={`${siteConfig.domain}/highlands-county-real-estate-market/`}
  schema={pageSchema}
>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-stone-100 border-b border-stone-200 py-3 px-4 sm:px-6" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center space-x-2 text-xs sm:text-sm text-stone-600">
      <a href="/" class="hover:text-[#1b3a5c] hover:underline">Home</a>
      <span aria-hidden="true" class="text-stone-400">/</span>
      <a href="/sebring-neighborhoods/" class="hover:text-[#1b3a5c] hover:underline">Communities</a>
      <span aria-hidden="true" class="text-stone-400">/</span>
      <span class="text-stone-900 font-semibold" aria-current="page">Highlands County Market Report</span>
    </div>
  </nav>

  <article class="py-12 sm:py-16 px-4 sm:px-6 font-sans">
    <div class="max-w-4xl mx-auto">
      <!-- Header -->
      <header class="mb-10">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-100 text-amber-900 border border-amber-300 mb-3">
          Quarterly Market Intelligence
        </span>
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-[#1b3a5c] tracking-tight mb-5 leading-tight">
          Highlands County, FL Real Estate Market Report & Trends
        </h1>
        <p class="text-lg sm:text-xl text-stone-700 leading-relaxed">
          Positioned along the scenic, rolling sand ridges of South-Central Florida, Highlands County represents one of the state's most resilient and accessible housing markets. Encompassing the thriving county seat of Sebring, the historic charm of Avon Park, and the freshwater haven of Lake Placid, the county continues to attract steady interest from out-of-state retirees, remote professionals, and regional families seeking affordable tranquility.
        </p>
        <p class="text-base text-stone-600 leading-relaxed mt-4">
          This comprehensive market report analyzes county-wide price trajectories, inventory velocities, and sub-market micro-climates, providing homeowners and buyers with objective, actionable data to guide informed financial decisions.
        </p>
      </header>

      <!-- Key Market Benchmark Indicators (Clearly Labeled Placeholders) -->
      <section class="mb-14 p-6 sm:p-8 bg-stone-50 rounded-2xl border border-stone-200 shadow-sm" aria-labelledby="benchmark-stats-heading">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-stone-200 pb-4 mb-6">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-[#8A4700]">Core Performance Benchmarks</span>
            <h2 id="benchmark-stats-heading" class="font-serif text-2xl font-bold text-[#1b3a5c] mt-0.5">
              Highlands County Housing Indicators
            </h2>
          </div>
          <span class="inline-flex items-center px-2.5 py-1 rounded text-xs font-bold bg-amber-100 text-amber-900 border border-amber-300">
            Pending Quarterly MLS Update
          </span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-6">
          <div class="p-4 bg-white rounded-xl border border-stone-200 text-center shadow-xs">
            <span class="block text-xs uppercase tracking-wider text-stone-500 font-semibold mb-1">County Median Price</span>
            <span class="font-serif text-xl sm:text-2xl font-bold text-[#1b3a5c]">$258,000</span>
            <span class="block text-[11px] text-amber-800 font-medium mt-1">[Pending Q-Update]</span>
          </div>

          <div class="p-4 bg-white rounded-xl border border-stone-200 text-center shadow-xs">
            <span class="block text-xs uppercase tracking-wider text-stone-500 font-semibold mb-1">Average Days on Market</span>
            <span class="font-serif text-xl sm:text-2xl font-bold text-[#1b3a5c]">54 Days</span>
            <span class="block text-[11px] text-amber-800 font-medium mt-1">[Pending Q-Update]</span>
          </div>

          <div class="p-4 bg-white rounded-xl border border-stone-200 text-center shadow-xs">
            <span class="block text-xs uppercase tracking-wider text-stone-500 font-semibold mb-1">Active County Inventory</span>
            <span class="font-serif text-xl sm:text-2xl font-bold text-[#1b3a5c]">~850 Homes</span>
            <span class="block text-[11px] text-amber-800 font-medium mt-1">[Pending Q-Update]</span>
          </div>

          <div class="p-4 bg-white rounded-xl border border-stone-200 text-center shadow-xs">
            <span class="block text-xs uppercase tracking-wider text-stone-500 font-semibold mb-1">Months of Supply</span>
            <span class="font-serif text-xl sm:text-2xl font-bold text-[#1b3a5c]">4.4 Months</span>
            <span class="block text-[11px] text-amber-800 font-medium mt-1">[Pending Q-Update]</span>
          </div>
        </div>

        <div class="mt-5 p-3.5 bg-amber-50/70 border border-amber-200 rounded-lg text-xs text-amber-950 leading-relaxed">
          <strong>Statistical Transparency Note:</strong> The figures above represent rolling benchmark metrics compiled from regional Highlands County Multiple Listing Service (MLS) transaction records across zip codes 33870, 33872, 33875, 33876, 33825, and 33852. All indicators are reviewed and refreshed quarterly to reflect certified closing records and shifting seasonal absorption rates.
        </div>
      </section>

      <!-- Section 1: Sub-Market Breakdown Across the Three Tri-Cities -->
      <section class="mb-14 space-y-6 text-stone-700 leading-relaxed" aria-labelledby="submarket-heading">
        <h2 id="submarket-heading" class="font-serif text-2xl sm:text-3xl font-bold text-[#1b3a5c]">
          Sub-Market Breakdown: Sebring, Avon Park & Lake Placid
        </h2>
        <p>
          Highlands County is not a homogeneous real estate market. The county’s three primary municipalities—known locally as the "Tri-Cities"—each operate with distinct pricing drivers, buyer demographics, and housing typologies. Understanding these micro-market variations is critical for accurate property valuation:
        </p>

        <div class="space-y-6 my-6">
          <!-- Sebring Submarket Card -->
          <div class="p-6 bg-white rounded-xl border border-stone-200 shadow-sm space-y-3">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-stone-100 pb-3">
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-[#8A4700]">Commercial & Healthcare Hub</span>
                <h3 class="font-serif text-xl font-bold text-[#1b3a5c]">
                  <a href="/sell-my-home-sebring-fl/" class="hover:underline">Sebring, FL Real Estate</a>
                </h3>
              </div>
              <span class="text-xs sm:text-sm font-bold text-stone-700 bg-stone-100 px-3 py-1 rounded-full w-fit">
                Median Price: ~$265,000 <span class="text-xs text-stone-500 font-normal">[Pending Q-Update]</span>
              </span>
            </div>
            <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
              As the county seat and central economic engine, Sebring represents the largest volume of residential transactions. Home to AdventHealth Sebring, the historic Downtown Historic Circle, and iconic water bodies like Lake Jackson and Dinner Lake, Sebring offers the broadest diversity of neighborhoods. The market spans master-planned golf communities like <a href="/sebring-neighborhoods/sun-n-lake/" class="text-[#1b3a5c] font-bold underline">Sun 'N Lake</a> and <a href="/sebring-neighborhoods/golf-hammock/" class="text-[#1b3a5c] font-bold underline">Golf Hammock</a>, world-class active-adult resort enclaves like <a href="/sebring-neighborhoods/tanglewood/" class="text-[#1b3a5c] font-bold underline">Tanglewood</a>, and private waterfront properties along <a href="/sebring-neighborhoods/lakefront-homes/" class="text-[#1b3a5c] font-bold underline">Lake Jackson's shoreline</a>.
            </p>
            <div class="pt-1 flex flex-wrap gap-3">
              <a href="/sebring-neighborhoods/" class="text-xs font-bold text-[#1b3a5c] hover:underline">
                Explore Sebring Neighborhoods →
              </a>
              <span class="text-stone-300">|</span>
              <a href="/sell-my-home-sebring-fl/" class="text-xs font-bold text-[#1b3a5c] hover:underline">
                Sebring Home Selling Guide →
              </a>
            </div>
          </div>

          <!-- Avon Park Submarket Card -->
          <div class="p-6 bg-white rounded-xl border border-stone-200 shadow-sm space-y-3">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-stone-100 pb-3">
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-emerald-800">Historic "City of Charm"</span>
                <h3 class="font-serif text-xl font-bold text-[#1b3a5c]">
                  <a href="/avon-park-real-estate/" class="hover:underline">Avon Park, FL Real Estate</a>
                </h3>
              </div>
              <span class="text-xs sm:text-sm font-bold text-stone-700 bg-stone-100 px-3 py-1 rounded-full w-fit">
                Median Price: ~$236,500 <span class="text-xs text-stone-500 font-normal">[Pending Q-Update]</span>
              </span>
            </div>
            <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
              Located at the northern border of Highlands County, Avon Park offers exceptional affordability and a relaxed historic ambiance centered on Main Street's famed Mile-Long Mall and the 1926 Jacaranda Hotel. Anchored by South Florida State College’s main campus, Avon Park provides shorter commute times to Polk County and Orlando. Housing includes historic in-town craftsman bungalows around Lake Verona, premier watersports residences on 800-acre Lake Lotela, and expansive rural acreage and ranchettes east of US-27.
            </p>
            <div class="pt-1">
              <a href="/avon-park-real-estate/" class="text-xs font-bold text-[#1b3a5c] hover:underline">
                Read the Full Avon Park Real Estate Guide →
              </a>
            </div>
          </div>

          <!-- Lake Placid Submarket Card -->
          <div class="p-6 bg-white rounded-xl border border-stone-200 shadow-sm space-y-3">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-stone-100 pb-3">
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-sky-800">Freshwater Haven & Arts Capital</span>
                <h3 class="font-serif text-xl font-bold text-[#1b3a5c]">
                  <a href="/lake-placid-real-estate/" class="hover:underline">Lake Placid, FL Real Estate</a>
                </h3>
              </div>
              <span class="text-xs sm:text-sm font-bold text-stone-700 bg-stone-100 px-3 py-1 rounded-full w-fit">
                Median Price: ~$272,000 <span class="text-xs text-stone-500 font-normal">[Pending Q-Update]</span>
              </span>
            </div>
            <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
              Renowned as Florida's "Town of Murals" and the "Caladium Capital of the World," Lake Placid sits at the southern end of the county surrounded by 27 freshwater lakes. It features Highlands County's most prestigious luxury lakefront corridor along 3,700-acre Lake June-in-Winter, accompanied by deep-water recreation on Lake Placid and tournament fishing on Lake Istokpoga. The area commands high seasonal cash demand from snowbirds and second-home buyers seeking turnkey lake lifestyle properties.
            </p>
            <div class="pt-1">
              <a href="/lake-placid-real-estate/" class="text-xs font-bold text-[#1b3a5c] hover:underline">
                Read the Full Lake Placid Real Estate Guide →
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 2: What This Means If You're Thinking of Selling -->
      <section class="mb-14 p-6 sm:p-8 bg-stone-50 rounded-2xl border border-stone-200 space-y-6 text-stone-700 leading-relaxed" aria-labelledby="seller-interpretation-heading">
        <div class="border-b border-stone-200 pb-4">
          <span class="text-xs font-bold uppercase tracking-wider text-[#8A4700]">Strategic Seller Advisory</span>
          <h2 id="seller-interpretation-heading" class="font-serif text-2xl sm:text-3xl font-bold text-[#1b3a5c] mt-1">
            What This Means If You're Thinking of Selling Your Home
          </h2>
          <p class="text-xs sm:text-sm text-stone-600 mt-1">
            Macroeconomic statistics tell a story, but tactical execution determines your net proceeds. Here is how current market conditions directly affect your home sale:
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Pillar 1: Pricing Precision -->
          <div class="p-5 bg-white rounded-xl border border-stone-200 shadow-xs space-y-2.5">
            <div class="w-9 h-9 rounded-lg bg-blue-50 text-[#1b3a5c] flex items-center justify-center font-bold text-lg">
              🎯
            </div>
            <h3 class="font-serif text-lg font-bold text-[#1b3a5c]">1. Pricing Precision Over Aspiration</h3>
            <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
              With county inventory sitting around 4.4 months of supply, buyers have options. During the feverish 2021 market, sellers could test aspirational prices and still attract bids. Today, homes priced just 4% to 7% above fair market value linger past the 60-day mark, accumulating stigma that ultimately leads to price cuts below true market value. Pricing precisely within 2% of calibrated neighborhood comps triggers multiple showings during your critical initial 14-day launch window.
            </p>
          </div>

          <!-- Pillar 2: The 4-Point Inspection Barrier -->
          <div class="p-5 bg-white rounded-xl border border-stone-200 shadow-xs space-y-2.5">
            <div class="w-9 h-9 rounded-lg bg-amber-50 text-amber-900 flex items-center justify-center font-bold text-lg">
              🛠️
            </div>
            <h3 class="font-serif text-lg font-bold text-[#1b3a5c]">2. The Roof & 4-Point Insurance Hurdle</h3>
            <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
              Florida’s homeowners insurance market remains the single greatest wildcard in closing escrow. On homes over 20 years old, carriers require a clean 4-Point Inspection (Roof, Electrical, Plumbing, HVAC). An architectural shingle roof older than 15 years—even if completely leak-free—can cause an unvetted buyer’s insurance application to fail five days before closing. We conduct pre-listing risk assessments to address roof certification concerns before going active on the MLS.
            </p>
          </div>

          <!-- Pillar 3: Cash Buyer Magnetism -->
          <div class="p-5 bg-white rounded-xl border border-stone-200 shadow-xs space-y-2.5">
            <div class="w-9 h-9 rounded-lg bg-emerald-50 text-emerald-900 flex items-center justify-center font-bold text-lg">
              💵
            </div>
            <h3 class="font-serif text-lg font-bold text-[#1b3a5c]">3. Capturing the 45%+ All-Cash Demographic</h3>
            <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
              Highlands County features an exceptionally high proportion of all-cash buyers—consisting primarily of northern retirees rolling substantial equity from home sales in Ohio, Michigan, New York, and Pennsylvania, alongside 1031 exchange investors. Cash buyers bypass appraisal delays and mortgage underwriting volatility. Our multi-MLS marketing campaigns specifically target out-of-state inbound relocators to maximize your chances of receiving clean, non-contingent cash offers.
            </p>
          </div>

          <!-- Pillar 4: Seasonal Timing Cadence -->
          <div class="p-5 bg-white rounded-xl border border-stone-200 shadow-xs space-y-2.5">
            <div class="w-9 h-9 rounded-lg bg-purple-50 text-purple-900 flex items-center justify-center font-bold text-lg">
              📅
            </div>
            <h3 class="font-serif text-lg font-bold text-[#1b3a5c]">4. Seasonal Timing & The Snowbird Surge</h3>
            <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
              While local families and healthcare employees at AdventHealth purchase year-round, the seasonal winter influx between November and April brings the highest concentration of motivated buyers. Launching in late fall or early winter allows you to showcase your home’s outdoor lanais, screened pool enclosures, and golf or lakefront amenities at their seasonal peak.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 3: Macro Trends Impacting Highlands County Real Estate -->
      <section class="mb-14 space-y-5 text-stone-700 leading-relaxed" aria-labelledby="macro-trends-heading">
        <h2 id="macro-trends-heading" class="font-serif text-2xl sm:text-3xl font-bold text-[#1b3a5c]">
          Macroeconomic Trends Shaping Highlands County Housing
        </h2>
        <p>
          Beyond local neighborhood dynamics, broader economic forces continue to influence property transactions across South-Central Florida:
        </p>

        <div class="space-y-4 my-6">
          <div class="p-5 bg-white rounded-xl border border-stone-200 shadow-sm">
            <h3 class="font-serif text-lg font-bold text-[#1b3a5c] mb-1.5">
              Cost-of-Living Migration from Coastal Florida Metros
            </h3>
            <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
              Highlands County has become a primary beneficiary of internal Florida migration. Buyers residing in high-density, high-cost coastal counties—such as Miami-Dade, Broward, Palm Beach, Hillsborough, and Orange—are increasingly cashing out their equity and moving inland. With Highlands County single-family homes averaging $235,000 to $275,000, coastal sellers can purchase a spacious home with land or fairway views, eliminate debt, and substantially reduce ongoing property insurance and HOA expenses.
            </p>
          </div>

          <div class="p-5 bg-white rounded-xl border border-stone-200 shadow-sm">
            <h3 class="font-serif text-lg font-bold text-[#1b3a5c] mb-1.5">
              Infrastructure & Transportation Corridors
            </h3>
            <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
              The continued commercial modernization of the US Highway 27 commercial corridor and improved arterial links toward US-98, SR-70, and the Florida Turnpike have expanded Highlands County’s accessibility. Remote and hybrid professionals can enjoy peaceful, rural lakeside living while remaining within a two-hour drive of international airports in Orlando, Tampa, Fort Myers, and West Palm Beach.
            </p>
          </div>

          <div class="p-5 bg-white rounded-xl border border-stone-200 shadow-sm">
            <h3 class="font-serif text-lg font-bold text-[#1b3a5c] mb-1.5">
              New Construction Velocity vs. Existing Inventory
            </h3>
            <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
              While production homebuilders have introduced targeted new construction communities in Sebring and Avon Park, infrastructure expansion costs have kept overall housing starts measured. This steady, non-speculative development pace protects existing home values, preventing the severe oversupply corrections seen in some larger Florida metropolitan suburbs.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 4: Lead Capture & Valuation Banner -->
      <section class="mb-14 p-6 sm:p-8 bg-white rounded-2xl border border-stone-200 shadow-lg text-center" aria-label="Complimentary Market Valuation">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-100 text-amber-900 border border-amber-300 mb-3">
          Neighborhood Precision Analysis
        </span>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#1b3a5c] mb-3">
          What Is Your Highlands County Home Worth in Today’s Market?
        </h2>
        <p class="text-xs sm:text-sm text-stone-600 max-w-xl mx-auto mb-6 leading-relaxed">
          Generic national valuation algorithms cannot verify your roof's remaining life, fairway orientation, or dock permit status. Request a complimentary, handcrafted Comparative Market Analysis prepared specifically for your address by Alyson Thomas.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <Button href="/free-home-valuation/" variant="primary" size="lg">
            Request Free Home Valuation →
          </Button>
          <a
            href={`tel:${siteConfig.phone}`}
            class="px-6 py-3 rounded-lg border border-stone-300 text-[#1b3a5c] font-bold text-sm hover:bg-stone-50 transition-colors"
          >
            Call {siteConfig.phoneDisplay}
          </a>
        </div>
      </section>

      <!-- Section 5: Frequently Asked Questions -->
      <section class="mb-14" aria-labelledby="market-faq-heading">
        <div class="border-b border-stone-200 pb-4 mb-6">
          <span class="text-xs font-bold uppercase tracking-wider text-[#8A4700]">Frequently Asked Questions</span>
          <h2 id="market-faq-heading" class="font-serif text-2xl sm:text-3xl font-bold text-[#1b3a5c] mt-1">
            Frequently Asked Questions: Highlands County Real Estate Market
          </h2>
          <p class="text-xs sm:text-sm text-stone-600 mt-1">
            Objective insights on prices, interest rates, and selling strategies:
          </p>
        </div>

        <FAQAccordion items={faqAccordionItems} title="" />
      </section>

      <!-- Section 6: Internal Pillar Links -->
      <section class="p-6 bg-stone-50 rounded-xl border border-stone-200 mb-10">
        <h2 class="font-serif text-lg font-bold text-[#1b3a5c] mb-3">Explore Highlands County Community Pillar Guides</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs sm:text-sm">
          <a href="/sell-my-home-sebring-fl/" class="p-3.5 bg-white rounded-lg border border-stone-200 hover:border-[#1b3a5c] transition-colors block">
            <span class="font-bold text-[#1b3a5c] block mb-1">Sebring Home Selling Guide</span>
