---
import { Image } from 'astro:assets';
import PageLayout from '@layouts/PageLayout.astro';
import Button from '@components/ui/Button.astro';
import { siteConfig, siteData } from '@data/site';
import { getCollection } from 'astro:content';
import { agentPortraitPlaceholder } from '@data/placeholderImages';

// Pull testimonials to weave into the narrative
const allTestimonials = await getCollection('testimonials');
const featuredTestimonial = allTestimonials[0] || {
  data: {
    quote:
      '[SAMPLE TESTIMONIAL — REPLACE WITH REAL CLIENT QUOTE] Alyson provided steady guidance, accurate pricing, and constant communication from listing through closing.',
    clientName: '[SAMPLE — REPLACE WITH REAL CLIENT]',
    neighborhood: 'Tanglewood',
    year: 2025,
    isPlaceholder: true,
  },
};
const secondTestimonial = allTestimonials[1];

// Page 2: About Schema Stack (RealEstateAgent with nested Person + BreadcrumbList)
const aboutSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'RealEstateAgent',
      '@id': `${siteConfig.domain}/#agent`,
      name: siteConfig.businessName,
      url: `${siteConfig.domain}/about/`,
      telephone: siteConfig.phone,
      image: `${siteConfig.domain}/social-preview-image.png`,
      priceRange: '$$',
      address: {
        '@type': 'PostalAddress',
        addressLocality: siteConfig.address.locality,
        addressRegion: siteConfig.address.region,
        postalCode: siteConfig.address.postalCode,
        addressCountry: siteConfig.address.country,
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: siteData.geo.latitude,
        longitude: siteData.geo.longitude,
      },
      areaServed: [
        { '@type': 'City', name: 'Sebring' },
        { '@type': 'City', name: 'Avon Park' },
        { '@type': 'City', name: 'Lake Placid' },
        { '@type': 'AdministrativeArea', name: 'Highlands County' },
      ],
      parentOrganization: {
        '@type': 'Organization',
        name: siteConfig.brokerage,
        url: siteConfig.domain,
      },
      employee: {
        '@type': 'Person',
        name: 'Alyson Thomas',
        jobTitle: 'Licensed Florida Real Estate Agent',
        telephone: siteConfig.phone,
        worksFor: {
          '@type': 'Organization',
          name: siteConfig.brokerage,
        },
      },
      sameAs: [
        siteConfig.directoryLinks.realtorDotCom,
        siteConfig.directoryLinks.myStateMLS,
      ],
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: `${siteConfig.domain}/`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'About Alyson Thomas',
          item: `${siteConfig.domain}/about/`,
        },
      ],
    },
  ],
};
---

<PageLayout
  title="About Alyson Thomas | Sebring, FL Real Estate Agent"
  description="Learn more about Alyson Thomas, licensed Florida real estate agent with Premier Plus Realty in Sebring, FL. Specializing in residential sales across Highlands County."
  canonicalUrl={`${siteConfig.domain}/about/`}
  schema={aboutSchema}
>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-stone-100 border-b border-stone-200 py-3 px-4 sm:px-6" aria-label="Breadcrumb">
    <div class="max-w-5xl mx-auto flex items-center space-x-2 text-xs sm:text-sm text-stone-600">
      <a href="/" class="hover:text-[#1b3a5c] hover:underline">Home</a>
      <span aria-hidden="true" class="text-stone-400">/</span>
      <span class="text-stone-900 font-semibold" aria-current="page">About Alyson Thomas</span>
    </div>
  </nav>

  <!-- Page Header & Professional Bio -->
  <article class="py-12 sm:py-16 px-4 sm:px-6">
    <div class="max-w-5xl mx-auto">
      <!-- Section 1: Intro & Agent Photo Placeholder -->
      <header class="mb-12">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-100 text-amber-900 border border-amber-300 mb-4">
          Licensed Florida Real Estate Agent
        </span>
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-[#1b3a5c] tracking-tight mb-6">
          About Alyson Thomas
        </h1>
        <p class="text-xl text-stone-700 font-sans leading-relaxed max-w-3xl">
          Dedicated residential sales specialist with Premier Plus Realty, representing homeowners and buyers across Sebring, Avon Park, Lake Placid, and Highlands County.
        </p>
      </header>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start mb-16">
        <!-- Photo Placeholder Column (Strictly NOT stock imagery, using Astro <Image />) -->
        <div class="lg:col-span-5 order-2 lg:order-1">
          <div class="bg-white rounded-2xl border-2 border-dashed border-amber-400/60 p-4 shadow-md text-center">
            <div class="aspect-[4/5] rounded-xl overflow-hidden border border-stone-300 shadow-inner bg-stone-100">
              <Image
                src={agentPortraitPlaceholder.image}
                alt="Portrait of Alyson Thomas, licensed real estate agent with Premier Plus Realty in Sebring, Florida"
                width={800}
                height={1000}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover"
              />
            </div>
            <div class="mt-3 py-2 px-3 bg-stone-50 rounded-lg text-xs text-stone-600 font-medium border border-stone-200">
              Personal Representation · Highlands County Local
            </div>
          </div>
        </div>

        <!-- Bio Content Column -->
        <div class="lg:col-span-7 order-1 lg:order-2 space-y-6 text-stone-800 text-base sm:text-lg leading-relaxed">
          <p>
            Real estate is rarely just about properties—it is about life transitions. Whether you are selling a family home, downsizing into one of Sebring's welcoming 55+ active adult communities, or relocating to Florida's scenic Heartland, having an honest, knowledgeable, and responsive advocate makes all the difference.
          </p>
          <p>
            As a licensed Florida real estate agent affiliated with <strong class="text-stone-900">Premier Plus Realty</strong>, I specialize in residential property sales throughout Highlands County. My focus centers on Sebring's diverse communities: from golf enclaves like Golf Hammock and Sun 'N Lake, to 55+ resort neighborhoods such as Tanglewood, Whisper Lake, and Buttonwood Bay, to the freshwater shores of Lake Jackson and Lake Josephine.
          </p>
          <p>
            I founded my practice on clear, direct communication and thorough market preparation. When you work with me, you work directly with me—every showing inquiry, every market analysis, and every offer negotiation receives my full personal attention.
          </p>
        </div>
      </div>

      <!-- Section 2: Local Connection Narrative -->
      <section class="mb-16 bg-stone-50 rounded-2xl p-8 sm:p-10 border border-stone-200">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#1b3a5c] mb-6">
          Rooted in Highlands County
        </h2>
        <div class="space-y-4 text-stone-700 text-base sm:text-lg leading-relaxed">
          <p>
            Highlands County has a unique rhythm that you cannot understand from a computer screen in a corporate office hundreds of miles away. It is defined by pristine freshwater lakes, morning breezes through the orange groves, peaceful fairway communities, and friendly neighborhood gatherings.
          </p>
          <p>
            Understanding Sebring requires knowing the micro-details: how land-lease terms differ from fee-simple ownership in manufactured home communities; which canals connect directly into Lake Josephine; how HOA dues and amenities vary between Sun 'N Lake and Spring Lake; and how seasonal buyer demand surges between October and April as northern residents seek Florida sunshine.
          </p>
          <p>
            My intimate connection with this community enables me to market Sebring homes not just as physical structures, but as lifestyles that out-of-area buyers are eager to embrace.
          </p>
        </div>
      </section>

      <!-- Section 3: Selling Philosophy in First Person -->
      <section class="mb-16">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#1b3a5c] mb-6">
          My Selling Philosophy
        </h2>
        <div class="space-y-5 text-stone-800 text-base sm:text-lg leading-relaxed">
          <p>
            I believe that every homeowner deserves honest, data-backed guidance rather than inflated promises. In real estate, an agent's job is not simply to agree with an arbitrary listing price to win a contract; it is to protect your hard-earned equity by positioning your property where the market will respond with qualified, competitive offers.
          </p>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 my-8">
            <div class="p-5 bg-white rounded-xl border border-stone-200 shadow-sm">
              <h3 class="font-serif font-bold text-[#1b3a5c] text-lg mb-2">1. Precision Pricing</h3>
              <p class="text-sm text-stone-600 leading-normal">
                I base every valuation on verified, localized comparable sales. Pricing accurately from day one prevents costly days on market and preserves your negotiating power.
              </p>
            </div>
            <div class="p-5 bg-white rounded-xl border border-stone-200 shadow-sm">
              <h3 class="font-serif font-bold text-[#1b3a5c] text-lg mb-2">2. Visual Excellence</h3>
              <p class="text-sm text-stone-600 leading-normal">
                Online listings are your property's first showing. I invest in high-definition photography and clear descriptive copywriting to capture buyer interest immediately.
              </p>
            </div>
            <div class="p-5 bg-white rounded-xl border border-stone-200 shadow-sm">
              <h3 class="font-serif font-bold text-[#1b3a5c] text-lg mb-2">3. Relentless Advocacy</h3>
              <p class="text-sm text-stone-600 leading-normal">
                From vetting pre-approval letters to handling repair requests and inspection contingencies, I represent your financial interests through to closing.
              </p>
            </div>
          </div>
          <p>
            Selling a home should be an empowering experience. I take pride in answering your calls promptly, walking you through every document, and removing uncertainty at every juncture.
          </p>
        </div>
      </section>

      <!-- Section 4: Woven Testimonial (Naturally integrated into narrative) -->
      <section class="mb-16 bg-[#1b3a5c]/5 rounded-2xl p-6 sm:p-8 border-l-4 border-[#d4923a]">
        <span class="text-xs font-bold text-[#8A4700] uppercase tracking-wider block mb-2">
          Real Client Impact
        </span>
        <blockquote class="font-serif italic text-lg sm:text-xl text-stone-900 leading-relaxed mb-4">
          "{featuredTestimonial.data.quote}"
        </blockquote>
        <footer class="flex items-center justify-between flex-wrap gap-2 text-sm">
          <span class="font-bold text-stone-900">— {featuredTestimonial.data.clientName}</span>
          <span class="text-xs text-stone-600">
            {featuredTestimonial.data.neighborhood && `Homeowner in ${featuredTestimonial.data.neighborhood}, `}Sebring FL ({featuredTestimonial.data.year})
          </span>
        </footer>

        {secondTestimonial && (
          <div class="mt-6 pt-6 border-t border-stone-200">
            <blockquote class="font-serif italic text-base text-stone-800 leading-relaxed mb-3">
              "{secondTestimonial.data.quote}"
            </blockquote>
            <footer class="text-xs text-stone-600 font-medium">
              — {secondTestimonial.data.clientName} ({secondTestimonial.data.neighborhood}, Sebring FL)
            </footer>
          </div>
        )}
      </section>

      <!-- Section 5: Credentials & Brokerage Verification (Strictly compliant) -->
      <section class="mb-16 bg-white rounded-2xl p-8 border border-stone-200 shadow-sm">
        <h2 class="font-serif text-2xl font-bold text-[#1b3a5c] mb-6">
          Professional Credentials & Licensing
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="p-4 rounded-lg bg-stone-50 border border-stone-200">
            <span class="text-xs font-semibold text-stone-500 uppercase tracking-wider block mb-1">
              State License
            </span>
            <span class="font-bold text-stone-900 text-sm sm:text-base block">
              Licensed Florida Real Estate Agent
            </span>
            <span class="text-xs text-amber-800 font-medium mt-1 block">
              License #{siteConfig.licenseNumber}
            </span>
          </div>

          <div class="p-4 rounded-lg bg-stone-50 border border-stone-200">
            <span class="text-xs font-semibold text-stone-500 uppercase tracking-wider block mb-1">
              Brokerage Affiliation
            </span>
            <span class="font-bold text-stone-900 text-sm sm:text-base block">
              {siteConfig.brokerage}
            </span>
            <span class="text-xs text-stone-600 mt-1 block">
              Residential Sales Division
            </span>
          </div>

          <div class="p-4 rounded-lg bg-stone-50 border border-stone-200">
            <span class="text-xs font-semibold text-stone-500 uppercase tracking-wider block mb-1">
              Core Service Areas
            </span>
            <span class="font-bold text-stone-900 text-sm sm:text-base block">
              Highlands County, Florida
            </span>
            <span class="text-xs text-stone-600 mt-1 block">
              Sebring · Avon Park · Lake Placid
            </span>
          </div>
        </div>
      </section>

      <!-- Section 6: Actionable CTAs per CRO Guide -->
      <section class="bg-[#1b3a5c] rounded-2xl p-8 sm:p-12 text-white text-center shadow-xl">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold mb-4">
          Let's Discuss Selling Your Home
        </h2>
        <p class="text-stone-200 text-base sm:text-lg max-w-2xl mx-auto mb-8 leading-relaxed font-sans">
          Whether you are ready to put a sign in your yard or simply exploring your property's value before making a decision, I welcome the opportunity to speak with you.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <Button href="/contact/" variant="primary" size="lg">
            Let's Discuss Selling Your Home →
          </Button>
          <a
            href="/free-home-valuation/"
            class="inline-flex items-center justify-center px-6 py-4 rounded-md font-bold text-white border-2 border-white/80 hover:border-white hover:bg-white/10 transition-all text-base min-h-[56px]"
          >
            Schedule a Free Consultation
          </a>
        </div>

        <div class="mt-6 pt-6 border-t border-white/20 text-sm text-stone-300">
          Direct Line: <a href={`tel:${siteConfig.phone}`} class="font-bold text-amber-300 hover:underline">{siteConfig.phoneDisplay}</a> · Available Mon–Sat 8:00 AM – 7:00 PM
        </div>
      </section>
    </div>
  </article>
</PageLayout>
