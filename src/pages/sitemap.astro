---
import PageLayout from '@layouts/PageLayout.astro';
import { siteConfig } from '@data/site';

// BreadcrumbList schema only per spec
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${siteConfig.domain}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'HTML Sitemap',
      item: `${siteConfig.domain}/sitemap/`,
    },
  ],
};

// Organized site architecture sections
const sitemapSections = [
  {
    title: 'Core & Company Pages',
    description: 'Direct access to Alyson Thomas, brokerage details, testimonials, and office contact.',
    links: [
      { name: 'Home Page', url: '/', description: 'Alyson Thomas real estate homepage and local property search.' },
      { name: 'About Alyson Thomas', url: '/about/', description: 'Background, Premier Plus Realty affiliation, licensing, and credentials.' },
      { name: 'Client Testimonials', url: '/testimonials/', description: 'Verified reviews and success stories from Highlands County buyers and sellers.' },
      { name: 'Contact & Office Info', url: '/contact/', description: 'Phone, email, office address, showing requests, and consultation form.' },
    ],
  },
  {
    title: 'Sebring Homes for Sale & Property Types',
    description: 'Comprehensive property search hubs categorized by lifestyle and construction style.',
    links: [
      { name: 'All Homes for Sale in Sebring', url: '/homes-for-sale-sebring-fl/', description: 'Primary buyer search hub for single-family residences across Sebring.' },
      { name: 'Condos & Villas for Sale', url: '/condos-villas-sebring-fl/', description: 'Low-maintenance condominiums, golf villas, and lakeside townhomes.' },
      { name: 'Golf Course Homes', url: '/golf-course-homes-sebring-fl/', description: 'Fairway residences in Sun \'N Lake, Golf Hammock, and Spring Lake.' },
      { name: 'Manufactured & Mobile Homes', url: '/mobile-homes-for-sale-sebring-fl/', description: 'Affordable 55+ active-adult resort living and private lot manufactured homes.' },
      { name: 'New Construction Homes', url: '/new-homes-sebring-fl/', description: 'Modern energy-efficient spec homes and new subdivisions across Sebring.' },
    ],
  },
  {
    title: 'Highlands County Neighborhood & Community Guides',
    description: 'In-depth profiles, HOA/CDD fee breakdowns, amenities, and market stats by community.',
    links: [
      { name: 'Sun \'N Lake of Sebring', url: '/sebring-neighborhoods/sun-n-lake/', description: 'Highlands County\'s largest master-planned golf and lake community.' },
      { name: 'Golf Hammock', url: '/sebring-neighborhoods/golf-hammock/', description: 'Established golf course community with mature tree canopies and custom homes.' },
      { name: 'Tanglewood (55+ Active Adult)', url: '/sebring-neighborhoods/tanglewood/', description: 'Premier gated resort community featuring pickleball, pool complex, and leased lots.' },
      { name: 'Spring Lake', url: '/sebring-neighborhoods/spring-lake/', description: 'Scenic golf and canal enclave near Lake Istokpoga with spacious homesites.' },
      { name: 'Buttonwood Bay (55+ Waterfront)', url: '/sebring-neighborhoods/buttonwood-bay/', description: 'Lakeside manufactured home community bordering Lake Josephine and Lake Jackson.' },
      { name: 'Sebring Village (55+ Community)', url: '/sebring-neighborhoods/sebring-village/', description: 'Centrally located retirement community near shopping, dining, and healthcare.' },
      { name: 'Whisper Lake (55+ Gated)', url: '/sebring-neighborhoods/whisper-lake/', description: 'Tranquil gated 55+ enclave centered around private spring-fed lakes.' },
      { name: 'Sebring Lakefront Homes', url: '/sebring-neighborhoods/lakefront-homes/', description: 'Waterfront estates on Lake Jackson, Dinner Lake, and Lake Sebring.' },
    ],
  },
  {
    title: 'Seller Resources & Strategic Valuation',
    description: 'Step-by-step guides, equity calculators, and marketing blueprints for Highlands County homeowners.',
    links: [
      { name: 'Sell My Home in Sebring', url: '/sell-my-home-sebring-fl/', description: 'Our proven 5-step selling roadmap from pricing and staging to contract closing.' },
      { name: 'Free Home Valuation', url: '/free-home-valuation/', description: 'Single-focus form for a customized, handcrafted Comparative Market Analysis.' },
      { name: 'Sell House Fast in Sebring', url: '/sell-house-fast-sebring-fl/', description: 'Expedited 14- to 30-day listing blueprint protecting equity against lowball wholesalers.' },
      { name: 'FSBO vs. Listing Agent Comparison', url: '/fsbo-vs-listing-agent-sebring/', description: 'Honest net proceeds math, NAR benchmark statistics, and disclosure liability.' },
      { name: 'Highlands County Home Selling Guide', url: '/home-selling-guide-highlands-county/', description: 'The definitive 10-step comprehensive handbook covering 4-point inspections and closing costs.' },
    ],
  },
  {
    title: 'Regional Municipal Pillars & Market Intelligence',
    description: 'Deep-dive geographic guides exploring the Tri-Cities and countywide market trends.',
    links: [
      { name: 'Avon Park Real Estate ("City of Charm")', url: '/avon-park-real-estate/', description: 'Historic downtown, South Florida State College, Lake Lotela, and cost of living.' },
      { name: 'Lake Placid Real Estate ("Town of Murals")', url: '/lake-placid-real-estate/', description: 'Lake June-in-Winter luxury waterfront, Caladium Festival, and seasonal snowbird market.' },
      { name: 'Highlands County Real Estate Market Report', url: '/highlands-county-real-estate-market/', description: 'Quarterly price benchmarks, inventory levels, interest rate analysis, and seller advisory.' },
    ],
  },
];
---

<PageLayout
  title="HTML Sitemap | Alyson Thomas Real Estate"
  description="Explore the complete site index of Alyson Thomas Real Estate: Sebring homes for sale, neighborhood guides, seller resources, and regional market analysis."
  canonicalUrl={`${siteConfig.domain}/sitemap/`}
  schema={pageSchema}
>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-stone-100 border-b border-stone-200 py-3 px-4 sm:px-6" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center space-x-2 text-xs sm:text-sm text-stone-600">
      <a href="/" class="hover:text-[#1b3a5c] hover:underline">Home</a>
      <span aria-hidden="true" class="text-stone-400">/</span>
      <span class="text-stone-900 font-semibold" aria-current="page">HTML Sitemap</span>
    </div>
  </nav>

  <main class="py-12 sm:py-16 px-4 sm:px-6 font-sans">
    <div class="max-w-4xl mx-auto">
      <header class="mb-12 border-b border-stone-200 pb-6">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-stone-200 text-stone-800 mb-3">
          Site Navigation Index
        </span>
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-[#1b3a5c] tracking-tight mb-4">
          HTML Sitemap & Complete Directory
        </h1>
        <p class="text-base sm:text-lg text-stone-600 leading-relaxed">
          Welcome to the complete navigation directory for Alyson Thomas Real Estate. Find homes for sale, explore Highlands County community guides, review selling resources, or discover regional market insights.
        </p>
      </header>

      <div class="space-y-12">
        {sitemapSections.map((section) => (
          <section class="p-6 sm:p-8 bg-stone-50 rounded-2xl border border-stone-200 shadow-xs">
            <h2 class="font-serif text-2xl font-bold text-[#1b3a5c] mb-1">
              {section.title}
            </h2>
            <p class="text-xs sm:text-sm text-stone-600 mb-6">
              {section.description}
            </p>

            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {section.links.map((link) => (
                <li class="p-4 bg-white rounded-xl border border-stone-200 hover:border-[#1b3a5c] transition-colors">
                  <a href={link.url} class="font-bold text-sm sm:text-base text-[#1b3a5c] hover:underline block mb-1">
                    {link.name} →
                  </a>
                  <p class="text-xs text-stone-600 leading-relaxed">
                    {link.description}
                  </p>
                  <span class="block text-[11px] font-mono text-stone-400 mt-2">
                    {link.url}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        ))}

        <!-- Legal & Governance Section -->
        <section class="p-6 bg-white rounded-xl border border-stone-200">
          <h2 class="font-serif text-lg font-bold text-stone-800 mb-2">Legal & Website Governance</h2>
          <div class="flex flex-wrap gap-4 text-xs sm:text-sm text-stone-600">
            <a href="/privacy-policy/" class="text-[#1b3a5c] hover:underline">
              Privacy Policy
            </a>
            <span class="text-stone-300">•</span>
            <a href="/terms-of-service/" class="text-[#1b3a5c] hover:underline">
              Terms of Service
            </a>
            <span class="text-stone-300">•</span>
            <span class="text-stone-500">
              Equal Housing Opportunity
            </span>
          </div>
        </section>
      </div>

      <!-- Footer CTA -->
      <div class="mt-12 p-6 sm:p-8 bg-[#1b3a5c] text-white rounded-2xl text-center">
        <h2 class="font-serif text-2xl font-bold mb-2">Need Direct Assistance in Highlands County?</h2>
        <p class="text-xs sm:text-sm text-stone-200 max-w-lg mx-auto mb-5">
          Connect with Alyson Thomas today for personalized home search assistance or a handcrafted property valuation.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href="/contact/"
            class="px-6 py-2.5 rounded-lg bg-amber-500 text-stone-950 font-bold text-sm hover:bg-amber-400 transition-colors"
          >
            Contact Alyson Thomas
          </a>
          <a
            href={`tel:${siteConfig.phone}`}
            class="px-6 py-2.5 rounded-lg border border-white/40 text-white font-bold text-sm hover:bg-white/10 transition-colors"
          >
            Call {siteConfig.phoneDisplay}
          </a>
        </div>
      </div>
    </div>
  </main>
</PageLayout>
