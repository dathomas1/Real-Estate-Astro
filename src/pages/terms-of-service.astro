---
import PageLayout from '@layouts/PageLayout.astro';
import { siteConfig } from '@data/site';

// BreadcrumbList schema only per spec
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${siteConfig.domain}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Terms of Service',
      item: `${siteConfig.domain}/terms-of-service/`,
    },
  ],
};
---

<PageLayout
  title="Terms of Service | Alyson Thomas Real Estate"
  description="Website Terms of Service, MLS listing disclaimers, and terms of use for Alyson Thomas at Premier Plus Realty in Sebring, FL."
  canonicalUrl={`${siteConfig.domain}/terms-of-service/`}
  schema={pageSchema}
>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-stone-100 border-b border-stone-200 py-3 px-4 sm:px-6" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center space-x-2 text-xs sm:text-sm text-stone-600">
      <a href="/" class="hover:text-[#1b3a5c] hover:underline">Home</a>
      <span aria-hidden="true" class="text-stone-400">/</span>
      <span class="text-stone-900 font-semibold" aria-current="page">Terms of Service</span>
    </div>
  </nav>

  <main class="py-12 sm:py-16 px-4 sm:px-6 font-sans">
    <div class="max-w-3xl mx-auto">
      <!-- Legal Review Notice Banner -->
      <div class="mb-8 p-5 bg-amber-50 border-2 border-amber-400 rounded-xl shadow-xs" role="alert">
        <div class="flex items-start gap-3">
          <span class="text-2xl flex-shrink-0" aria-hidden="true">⚠️</span>
          <div>
            <h2 class="text-sm font-bold uppercase tracking-wider text-amber-900 mb-1">
              Template Notice — Pre-Launch Legal Review Required
            </h2>
            <p class="text-xs sm:text-sm text-amber-950 leading-relaxed">
              <strong>Administrative Flag:</strong> This document is a standard real estate website terms of service template created for development purposes. Prior to official commercial deployment, these terms must be formally reviewed, approved, and updated by licensed Florida legal counsel and {siteConfig.brokerage} compliance leadership to address state-specific brokerage disclosure rules and local MLS display regulations.
            </p>
          </div>
        </div>
      </div>

      <header class="mb-10 pb-6 border-b border-stone-200">
        <h1 class="font-serif text-3xl sm:text-4xl font-bold text-[#1b3a5c] tracking-tight mb-3">
          Terms of Service
        </h1>
        <p class="text-xs sm:text-sm text-stone-500">
          Last Updated: September 2026 • Effective Date: September 2026
        </p>
      </header>

      <div class="space-y-8 text-stone-700 text-sm sm:text-base leading-relaxed">
        <section>
          <h2 class="font-serif text-xl sm:text-2xl font-bold text-[#1b3a5c] mb-3">
            1. Agreement to Terms
          </h2>
          <p>
            Welcome to the website of {siteConfig.businessName} (operating through {siteConfig.brokerage}). By browsing, accessing, or utilizing any portion of <a href={siteConfig.domain} class="text-[#1b3a5c] underline">{siteConfig.domain}</a> (the "Site"), you acknowledge that you have read, understood, and agree to be bound by these Terms of Service and our associated Privacy Policy. If you do not agree to these terms, you must immediately discontinue using this Site.
          </p>
        </section>

        <section>
          <h2 class="font-serif text-xl sm:text-2xl font-bold text-[#1b3a5c] mb-3">
            2. Real Estate Information & Professional Advice Disclaimer
          </h2>
          <p>
            The content, articles, neighborhood guides, calculators, and property valuation estimates provided on this Site are for general informational and educational purposes only.
          </p>
          <ul class="list-disc pl-5 mt-2 space-y-2 text-stone-600 text-sm">
            <li><strong>Not a Certified Appraisal:</strong> Any Comparative Market Analysis (CMA) or automated home valuation estimate presented on or generated through this Site is a licensed real estate professional’s opinion of market pricing, not a formal appraisal conducted by a state-certified real estate appraiser.</li>
            <li><strong>Not Legal, Tax, or Financial Advice:</strong> No information on this Site constitutes formal legal, tax, accounting, or structural engineering advice. Prospective buyers and sellers are strongly advised to consult certified public accountants, real estate attorneys, structural engineers, and certified home inspectors regarding their specific legal, financial, and physical property questions.</li>
          </ul>
        </section>

        <section>
          <h2 class="font-serif text-xl sm:text-2xl font-bold text-[#1b3a5c] mb-3">
            3. MLS Listing Data & Information Accuracy
          </h2>
          <p>
            Property listings, community details, square footages, lot dimensions, tax estimates, HOA/CDD fees, school district boundaries, and architectural features displayed on this Site are compiled from sources believed to be reliable, including the Heartland Association of MLS, Stellar MLS, and local municipal property appraiser records.
          </p>
          <p class="mt-2">
            However, listing data is subject to errors, omissions, price changes, prior sales, or withdrawal from the market without notice. Neither {siteConfig.businessName} nor {siteConfig.brokerage} guarantees or warrants the accuracy of any listing information. All prospective buyers and investors are independently responsible for verifying all physical and financial property details through personal inspection and certified professional examinations.
          </p>
        </section>

        <section>
          <h2 class="font-serif text-xl sm:text-2xl font-bold text-[#1b3a5c] mb-3">
            4. Equal Housing Opportunity
          </h2>
          <p>
            {siteConfig.businessName} and {siteConfig.brokerage} fully support and comply with the principles of the federal <strong>Fair Housing Act</strong> (Title VIII of the Civil Rights Act of 1968), the Florida Fair Housing Act, and the Americans with Disabilities Act.
          </p>
          <p class="mt-2">
            We do not discriminate in the sale, rental, financing, or advertising of housing based on race, color, religion, sex, handicap, familial status, national origin, or any other protected classification under federal, state, or municipal law.
          </p>
        </section>

        <section>
          <h2 class="font-serif text-xl sm:text-2xl font-bold text-[#1b3a5c] mb-3">
            5. Florida Real Estate Brokerage Relationships
          </h2>
          <p>
            Visiting this Site or submitting an inquiry does not create a formal fiduciary or client representation relationship. Under Florida Statute § 475.278, Florida law presumes that a real estate licensee operates as a <strong>Transaction Broker</strong> unless a single agent or no-brokerage relationship is established in writing. A client representation relationship with Alyson Thomas is formalized solely upon the mutual execution of an official Florida listing agreement or exclusive buyer representation agreement.
          </p>
        </section>

        <section>
          <h2 class="font-serif text-xl sm:text-2xl font-bold text-[#1b3a5c] mb-3">
            6. Intellectual Property Rights & Use Restrictions
          </h2>
          <p>
            All content on this Site—including articles, market analyses, custom architectural photography, aerial drone footage, floor plans, graphics, and branding—is the exclusive intellectual property of {siteConfig.businessName} or licensed from third-party content providers.
          </p>
          <p class="mt-2">
            You are granted a limited, revocable, non-exclusive license to view and print individual pages for your personal, non-commercial use in evaluating prospective real estate transactions. You agree not to scrape, harvest, reproduce, republish, distribute, or reverse-engineer any portion of this Site without prior express written permission.
          </p>
        </section>

        <section>
          <h2 class="font-serif text-xl sm:text-2xl font-bold text-[#1b3a5c] mb-3">
            7. Limitation of Liability
          </h2>
          <p>
            To the fullest extent permitted by applicable Florida law, {siteConfig.businessName}, {siteConfig.brokerage}, and their respective officers, agents, and affiliates shall not be liable for any direct, indirect, incidental, consequential, special, or punitive damages arising from your access to or inability to access this Site, or from your reliance upon any information provided herein.
          </p>
        </section>

        <section>
          <h2 class="font-serif text-xl sm:text-2xl font-bold text-[#1b3a5c] mb-3">
            8. Governing Law & Dispute Resolution
          </h2>
          <p>
            These Terms of Service are governed by and construed in accordance with the laws of the <strong>State of Florida</strong>, without regard to its conflict of law principles. Any legal action, claim, or proceeding arising out of or related to this Site or these terms shall be instituted exclusively in the state or federal courts situated in <strong>Highlands County, Florida</strong>.
          </p>
        </section>

        <section>
          <h2 class="font-serif text-xl sm:text-2xl font-bold text-[#1b3a5c] mb-3">
            9. Contact & Legal Notices
          </h2>
          <p>
            For questions regarding these Terms of Service or to deliver official notices, please contact:
          </p>
          <div class="mt-4 p-5 bg-stone-50 rounded-xl border border-stone-200 text-xs sm:text-sm space-y-1.5">
            <p class="font-bold text-[#1b3a5c]">{siteConfig.businessName}</p>
            <p class="text-stone-600">Brokerage: {siteConfig.brokerage}</p>
            <p class="text-stone-600">Address: {siteConfig.address.locality}, {siteConfig.address.region} {siteConfig.address.postalCode}</p>
            <p class="text-stone-600">Telephone: <a href={`tel:${siteConfig.phone}`} class="text-[#1b3a5c] font-semibold underline">{siteConfig.phoneDisplay}</a></p>
            <p class="text-stone-600">Website: <a href={siteConfig.domain} class="text-[#1b3a5c] underline">{siteConfig.domain}</a></p>
          </div>
        </section>
      </div>

      <!-- Return Link -->
      <div class="mt-12 pt-6 border-t border-stone-200 text-center">
        <a href="/" class="text-xs sm:text-sm font-bold text-[#1b3a5c] hover:underline">
          ← Return to Home Page
        </a>
      </div>
    </div>
  </main>
</PageLayout>
