---
import PageLayout from '@layouts/PageLayout.astro';
import { siteConfig, siteData } from '@data/site';

// Page 3: Contact Schema Stack (RealEstateAgent with ContactPoint + BreadcrumbList)
const contactSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'RealEstateAgent',
      '@id': `${siteConfig.domain}/#agent`,
      name: siteConfig.businessName,
      url: `${siteConfig.domain}/contact/`,
      telephone: siteConfig.phone,
      image: `${siteConfig.domain}/social-preview-image.png`,
      priceRange: '$$',
      address: {
        '@type': 'PostalAddress',
        addressLocality: siteConfig.address.locality,
        addressRegion: siteConfig.address.region,
        postalCode: siteConfig.address.postalCode,
        addressCountry: siteConfig.address.country,
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: siteData.geo.latitude,
        longitude: siteData.geo.longitude,
      },
      contactPoint: [
        {
          '@type': 'ContactPoint',
          telephone: siteConfig.phone,
          contactType: 'customer service',
          areaServed: 'Highlands County, FL',
          availableLanguage: ['English'],
          hoursAvailable: [
            {
              '@type': 'OpeningHoursSpecification',
              dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
              opens: '08:00',
              closes: '19:00',
            },
            {
              '@type': 'OpeningHoursSpecification',
              dayOfWeek: ['Saturday'],
              opens: '09:00',
              closes: '17:00',
            },
            {
              '@type': 'OpeningHoursSpecification',
              dayOfWeek: ['Sunday'],
              opens: '13:00',
              closes: '17:00',
            },
          ],
        },
      ],
      areaServed: [
        { '@type': 'City', name: 'Sebring' },
        { '@type': 'City', name: 'Avon Park' },
        { '@type': 'City', name: 'Lake Placid' },
        { '@type': 'AdministrativeArea', name: 'Highlands County' },
      ],
      parentOrganization: {
        '@type': 'Organization',
        name: siteConfig.brokerage,
        url: siteConfig.domain,
      },
      sameAs: [
        siteConfig.directoryLinks.realtorDotCom,
        siteConfig.directoryLinks.myStateMLS,
      ],
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: `${siteConfig.domain}/`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Contact',
          item: `${siteConfig.domain}/contact/`,
        },
      ],
    },
  ],
};
---

<PageLayout
  title="Contact Alyson Thomas | Sebring, FL Real Estate Agent"
  description="Get in touch with Alyson Thomas, real estate agent with Premier Plus Realty in Sebring, FL. Call (772) 342-8085 or send a message for home buying and selling inquiries."
  canonicalUrl={`${siteConfig.domain}/contact/`}
  schema={contactSchema}
>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-stone-100 border-b border-stone-200 py-3 px-4 sm:px-6" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center space-x-2 text-xs sm:text-sm text-stone-600">
      <a href="/" class="hover:text-[#1b3a5c] hover:underline">Home</a>
      <span aria-hidden="true" class="text-stone-400">/</span>
      <span class="text-stone-900 font-semibold" aria-current="page">Contact</span>
    </div>
  </nav>

  <main class="py-12 sm:py-16 px-4 sm:px-6">
    <div class="max-w-7xl mx-auto">
      <!-- Page Header -->
      <header class="max-w-3xl mb-12">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-100 text-amber-900 border border-amber-300 mb-4">
          Direct Agent Communication
        </span>
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-[#1b3a5c] tracking-tight mb-4">
          Contact Alyson Thomas
        </h1>
        <p class="text-base sm:text-lg text-stone-700 leading-relaxed font-sans">
          Have questions about buying a home, selling your property, or assessing current market values in Sebring and Highlands County? Reach out directly by phone or submit the message form below.
        </p>
      </header>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
        <!-- Left Column: Prominent NAP, Phone, Hours, and Map Placeholder -->
        <div class="lg:col-span-5 space-y-6">
          <!-- Primary NAP Card -->
          <div class="bg-white rounded-2xl p-6 sm:p-7 border border-stone-200 shadow-sm space-y-5">
            <h2 class="font-serif text-xl font-bold text-[#1b3a5c] border-b border-stone-100 pb-3">
              Office & Agent Details
            </h2>

            <!-- Name & Brokerage -->
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-stone-500 block mb-1">
                Real Estate Professional
              </span>
              <p class="text-base font-bold text-stone-900">
                {siteConfig.businessName}
              </p>
              <p class="text-xs text-stone-600 mt-0.5">
                Licensed Florida Real Estate Agent — License #{siteConfig.licenseNumber}
              </p>
            </div>

            <!-- Address -->
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-stone-500 block mb-1">
                Location
              </span>
              <p class="text-sm font-semibold text-stone-800">
                {siteConfig.brokerage}
              </p>
              <p class="text-sm text-stone-700">
                {siteConfig.address.locality}, {siteConfig.address.region} {siteConfig.address.postalCode}, {siteConfig.address.country}
              </p>
              <p class="text-xs text-stone-500 mt-1">
                Serving Sebring, Avon Park, Lake Placid & surrounding Highlands County
              </p>
            </div>

            <!-- Click-to-Call Primary Action -->
            <div class="pt-2">
              <span class="text-xs font-bold uppercase tracking-wider text-stone-500 block mb-2">
                Direct Telephone
              </span>
              <a
                href={`tel:${siteConfig.phone}`}
                class="inline-flex items-center justify-center w-full px-5 py-3.5 rounded-lg font-bold text-white bg-[#1b3a5c] hover:bg-[#122944] shadow-sm transition-all text-base min-h-[48px] text-center"
                aria-label={`Call Alyson Thomas directly at ${siteConfig.phoneDisplay}`}
              >
                📞 Call {siteConfig.phoneDisplay}
              </a>
            </div>

            <!-- Email Placeholder -->
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-stone-500 block mb-1">
                Direct Email
              </span>
              <p class="text-sm font-semibold text-stone-800">
                {siteData.email}
              </p>
              <span class="text-[11px] text-stone-500 block mt-0.5">
                [Placeholder — Official email will be activated upon domain deployment]
              </span>
            </div>
          </div>

          <!-- Operating Hours Card -->
          <div class="bg-stone-50 rounded-2xl p-6 border border-stone-200 shadow-sm">
            <h2 class="font-serif text-lg font-bold text-[#1b3a5c] mb-3 flex items-center gap-2">
              <span>🕒</span>
              <span>Operating Hours</span>
            </h2>
            <dl class="space-y-2 text-sm">
              <div class="flex justify-between py-1 border-b border-stone-200">
                <dt class="font-medium text-stone-700">Monday – Friday</dt>
                <dd class="font-semibold text-stone-900">{siteData.hours.weekday}</dd>
              </div>
              <div class="flex justify-between py-1 border-b border-stone-200">
                <dt class="font-medium text-stone-700">Saturday</dt>
                <dd class="font-semibold text-stone-900">{siteData.hours.saturday}</dd>
              </div>
              <div class="flex justify-between py-1">
                <dt class="font-medium text-stone-700">Sunday</dt>
                <dd class="font-semibold text-stone-900">{siteData.hours.sunday}</dd>
              </div>
            </dl>
            <p class="text-xs text-stone-500 mt-3 pt-2 border-t border-stone-200">
              Weekend showings, comparative market analyses, and listing consultations available by appointment.
            </p>
          </div>

          <!-- Google Maps Embed Placeholder (Centered on Sebring, FL) -->
          <div class="bg-white rounded-2xl p-5 border-2 border-dashed border-amber-300/80 shadow-sm text-center">
            <div class="aspect-[16/9] rounded-xl bg-stone-100 border border-stone-200 flex flex-col items-center justify-center p-4">
              <span class="text-2xl mb-1" aria-hidden="true">📍</span>
              <span class="text-xs font-bold uppercase tracking-wider text-amber-900 bg-amber-100 border border-amber-300 px-2 py-0.5 rounded mb-2">
                Map Embed Placeholder
              </span>
              <p class="text-xs font-semibold text-stone-800">
                [Google Maps Interactive Embed Placeholder]
              </p>
              <p class="text-[11px] text-stone-600 mt-1">
                Centered on Sebring, FL 33872 (27.4956° N, 81.4412° W)
              </p>
              <p class="text-[10px] text-stone-500 mt-0.5 italic">
                Will be populated with live Google Maps Platform embed upon production API key configuration.
              </p>
            </div>
          </div>
        </div>

        <!-- Right Column: Contact Form Shell (Static markup only) -->
        <div class="lg:col-span-7 bg-white rounded-2xl p-6 sm:p-8 border border-stone-200 shadow-lg">
          <div class="border-b border-stone-200 pb-4 mb-6">
            <span class="text-xs font-bold uppercase tracking-wider text-[#8A4700]">Inquiry Form</span>
            <h2 class="font-serif text-2xl font-bold text-[#1b3a5c] mt-1">
              Send a Direct Message
            </h2>
            <p class="text-xs sm:text-sm text-stone-600 mt-1">
              Please share how Alyson can assist you. You will receive a prompt response within 24 hours.
            </p>
          </div>

          {/* 
            NOTE: Form backend / submission needs to be wired to an active backend endpoint or serverless handler later;
            this is static markup only. Do not fake a working submission.
          */}
          <form class="space-y-4" onsubmit="event.preventDefault();">
            <!-- Full Name -->
            <div>
              <label for="name" class="block text-xs font-bold text-stone-800 mb-1">
                Full Name <span class="text-amber-700">*</span>
              </label>
              <input
                type="text"
                id="name"
                name="name"
                placeholder="Jane & John Doe"
                required
                class="w-full px-3 py-2.5 text-sm text-stone-900 border border-stone-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#1b3a5c]"
              />
            </div>

            <!-- Email and Phone Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="email" class="block text-xs font-bold text-stone-800 mb-1">
                  Email Address <span class="text-amber-700">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  placeholder="your.name@example.com"
                  required
                  class="w-full px-3 py-2.5 text-sm text-stone-900 border border-stone-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#1b3a5c]"
                />
              </div>
              <div>
                <label for="phone" class="block text-xs font-bold text-stone-800 mb-1">
                  Phone Number <span class="text-amber-700">*</span>
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  placeholder="(863) 555-0123"
                  required
                  class="w-full px-3 py-2.5 text-sm text-stone-900 border border-stone-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#1b3a5c]"
                />
              </div>
            </div>

            <!-- Inquiry Type Dropdown: buying / selling / valuation / other -->
            <div>
              <label for="inquiry-type" class="block text-xs font-bold text-stone-800 mb-1">
                How Can Alyson Help You? <span class="text-amber-700">*</span>
              </label>
              <select
                id="inquiry-type"
                name="inquiryType"
                required
                class="w-full px-3 py-2.5 text-sm text-stone-900 bg-white border border-stone-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#1b3a5c]"
              >
                <option value="" disabled selected>Select an inquiry topic...</option>
                <option value="selling">Selling a Home in Sebring / Highlands County</option>
                <option value="buying">Buying a Home or 55+ Community Property</option>
                <option value="valuation">Requesting a Free Home Valuation (CMA)</option>
                <option value="other">Other Real Estate Question</option>
              </select>
            </div>

            <!-- Message Area -->
            <div>
              <label for="message" class="block text-xs font-bold text-stone-800 mb-1">
                Message or Details <span class="text-amber-700">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                rows="4"
                placeholder="Tell Alyson about your timeline, preferred neighborhood, or current property..."
                required
                class="w-full px-3 py-2.5 text-sm text-stone-900 border border-stone-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#1b3a5c]"
              ></textarea>
            </div>

            <!-- Note noting future backend wiring -->
            <div class="p-3 bg-stone-50 border border-stone-200 rounded-md text-[11px] text-stone-500 leading-snug">
              <span class="font-semibold text-stone-700">Notice:</span> This form is currently in staging shell mode. Form backend endpoints will be wired prior to launch. For immediate response, please call <a href={`tel:${siteConfig.phone}`} class="font-bold text-[#1b3a5c] underline">{siteConfig.phoneDisplay}</a>.
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              class="w-full py-3.5 px-4 rounded-md font-bold text-[#122944] hover:text-[#0b1726] shadow-sm transition-all cursor-pointer text-base bg-[#d4923a] hover:bg-[#b87a2e] min-h-[48px] text-center"
            >
              Send Message to Alyson →
            </button>
          </form>
        </div>
      </div>
    </div>
  </main>
</PageLayout>
