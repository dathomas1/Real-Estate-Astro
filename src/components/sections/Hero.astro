---
import { Image } from 'astro:assets';
import Button from '@components/ui/Button.astro';
import { siteConfig } from '@data/site';
import { agentPortraitPlaceholder } from '@data/placeholderImages';

interface Props {
  headline?: string;
  subheadline?: string;
  primaryCtaText?: string;
  primaryCtaHref?: string;
}

const {
  headline = 'Your Trusted Real Estate Agent in Sebring, Florida',
  subheadline = "Whether you're selling your home for top dollar or finding your Florida dream property, Alyson Thomas delivers neighborhood-level expertise, dedicated personal service, and proven results throughout Sebring and Highlands County.",
  primaryCtaText = 'Get Your Free Home Valuation',
  primaryCtaHref = '/free-home-valuation/',
} = Astro.props;
---

<section class="relative bg-[#1b3a5c] text-white pt-12 sm:pt-16 pb-16 sm:pb-20 px-4 sm:px-6 overflow-hidden">
  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
    <!-- Left Column: Primary Copy & Dual CTAs -->
    <div class="lg:col-span-7 text-left">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-[#122944] text-amber-300 border border-amber-400/30 mb-6 shadow-sm">
        <span>Sebring · Avon Park · Lake Placid · Highlands County</span>
      </div>

      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white mb-6 leading-[1.15]">
        {headline}
      </h1>

      <p class="text-lg sm:text-xl text-stone-200 mb-8 leading-relaxed max-w-2xl font-sans">
        {subheadline}
      </p>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mb-6">
        <Button href={primaryCtaHref} variant="primary" size="lg">
          {primaryCtaText} →
        </Button>
        <a
          href={`tel:${siteConfig.phone}`}
          class="inline-flex items-center justify-center px-6 py-4 rounded-md font-bold text-white border-2 border-white/80 hover:border-white hover:bg-white/10 transition-all text-base min-h-[56px] text-center"
          aria-label={`Call Alyson Thomas directly at ${siteConfig.phoneDisplay}`}
        >
          📞 Call {siteConfig.phoneDisplay}
        </a>
      </div>

      <!-- Trust Bar Line per CRO Guide 4.1 Section 1 -->
      <div class="pt-4 border-t border-white/20">
        <p class="text-sm sm:text-base font-semibold text-amber-200 tracking-wide flex items-center gap-2">
          <span>Licensed FL Agent</span>
          <span aria-hidden="true" class="text-white/40">·</span>
          <span>Premier Plus Realty</span>
          <span aria-hidden="true" class="text-white/40">·</span>
          <span>Sebring Seller Specialist</span>
        </p>
      </div>
    </div>

    <!-- Right Column: Labeled Agent Portrait Slot via Astro <Image /> (Eager Loading for LCP) -->
    <div class="lg:col-span-5 flex justify-center">
      <div class="w-full max-w-md bg-stone-100 rounded-2xl overflow-hidden border-2 border-dashed border-amber-300/60 p-4 sm:p-5 text-stone-900 shadow-2xl relative flex flex-col items-center">
        <!-- Astro Image Component: Explicit width & height to prevent CLS, EAGER loading (NOT lazy) for Homepage Hero per CRO Guide 3.1 & Architecture 4C -->
        <div class="w-full aspect-[4/5] rounded-xl overflow-hidden border border-stone-300 shadow-inner relative bg-stone-200">
          <Image
            src={agentPortraitPlaceholder.image}
            alt={agentPortraitPlaceholder.alt}
            width={agentPortraitPlaceholder.width}
            height={agentPortraitPlaceholder.height}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="w-full h-full object-cover"
          />
        </div>

        <!-- Mini Agent Bio Snippet -->
        <div class="w-full mt-3 bg-white rounded-lg p-3 border border-stone-200 text-center">
          <h2 class="font-serif font-bold text-[#1b3a5c] text-base">Alyson Thomas</h2>
          <p class="text-xs text-stone-600 font-medium">Premier Plus Realty · Sebring, FL</p>
        </div>
      </div>
    </div>
  </div>
</section>
