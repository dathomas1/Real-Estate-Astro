---
import { getCollection } from 'astro:content';
import TestimonialCard from '@components/ui/TestimonialCard.astro';
import Button from '@components/ui/Button.astro';

// Pull up to 2 entries from the testimonials collection
const allTestimonials = await getCollection('testimonials');
const testimonials = allTestimonials.slice(0, 2);
---

<section class="py-16 sm:py-20 bg-stone-50 border-b border-stone-200" id="testimonials">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-100 text-amber-900 border border-amber-300 mb-3">
        Client Experiences
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#1b3a5c] mb-4">
        What Sebring Homeowners Say
      </h2>
      <p class="text-base sm:text-lg text-stone-700 leading-relaxed font-sans">
        Hear from local clients who trusted Alyson to market their properties, negotiate favorable terms, and guide them across the finish line.
      </p>
    </div>

    <!-- Testimonials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto mb-12">
      {testimonials.map((item) => (
        <TestimonialCard
          quote={item.data.quote}
          clientName={item.data.clientName}
          neighborhood={item.data.neighborhood}
          year={item.data.year}
          isPlaceholder={item.data.isPlaceholder}
        />
      ))}
    </div>

    <!-- Review Navigation & CTA -->
    <div class="text-center flex flex-col sm:flex-row items-center justify-center gap-4">
      <Button href="/testimonials/" variant="primary" size="md">
        Read More Client Stories →
      </Button>
      <a
        href="/free-home-valuation/"
        class="text-sm font-bold text-[#1b3a5c] hover:underline"
      >
        Request Your Free Valuation Today
      </a>
    </div>
  </div>
</section>
