---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  items: FAQItem[];
  title?: string;
}

const { items, title = 'Frequently Asked Questions' } = Astro.props;
---

<div class="w-full max-w-3xl mx-auto my-8">
  {title && (
    <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#1b3a5c] text-center mb-8">
      {title}
    </h2>
  )}

  <div class="space-y-4">
    {
      items.map((item) => (
        <details class="group bg-white border border-stone-200 rounded-lg p-5 shadow-sm transition-all duration-150 open:border-amber-400 open:shadow-md">
          <summary class="flex justify-between items-center font-serif text-base sm:text-lg font-bold text-gray-900 cursor-pointer list-none focus:outline-none focus:ring-2 focus:ring-amber-400 rounded">
            <span>{item.question}</span>
            <span class="ml-4 transition-transform duration-200 group-open:rotate-180 text-[#d4923a]">
              ▼
            </span>
          </summary>
          <div class="mt-4 pt-3 border-t border-stone-100 text-sm sm:text-base text-gray-700 leading-relaxed">
            <p>{item.answer}</p>
          </div>
        </details>
      ))
    }
  </div>
</div>
