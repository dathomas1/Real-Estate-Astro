---
import { siteConfig } from '@data/site';
---

<section class="bg-[#122944] text-stone-200 py-6 border-y border-amber-500/20" aria-label="Credentials and licensing verification">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4 text-center md:text-left">
      <!-- Brokerage & License Verification -->
      <div class="flex flex-col sm:flex-row items-center gap-2 sm:gap-3">
        <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-amber-400/20 text-amber-300 font-bold text-sm shrink-0" aria-hidden="true">
          ✓
        </span>
        <div class="text-sm font-medium">
          <span class="text-white font-bold">Licensed Florida Real Estate Agent</span>
          <span class="text-stone-400 mx-1.5 hidden sm:inline">|</span>
          <span class="text-amber-200">License #{siteConfig.licenseNumber}</span>
          <span class="text-stone-400 mx-1.5 hidden sm:inline">|</span>
          <span class="text-stone-300">{siteConfig.brokerage}</span>
        </div>
      </div>

      <!-- Service Area Badges -->
      <div class="flex items-center flex-wrap justify-center gap-2 text-xs font-semibold text-stone-300">
        <span class="text-amber-300 uppercase tracking-wider text-[11px] mr-1">Highlands County Areas:</span>
        {siteConfig.serviceAreas.map((area) => (
          <span class="bg-white/10 px-2.5 py-1 rounded text-stone-100 border border-white/10">
            {area}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
