---
import { siteConfig, siteData } from '@data/site';
---

<section class="py-16 sm:py-20 bg-stone-900 text-stone-100" id="contact">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Left Column: Value Proposition & Canonical NAP Information -->
      <div class="lg:col-span-6 space-y-6">
        <div>
          <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-400/20 text-amber-300 border border-amber-400/30 mb-3">
            Get in Touch
          </span>
          <h2 class="font-serif text-3xl sm:text-4xl font-bold text-white mb-4">
            Ready to Discuss Your Sebring Home?
          </h2>
          <p class="text-stone-300 text-base sm:text-lg leading-relaxed font-sans">
            Whether you are considering selling in the next month, planning ahead for seasonal market timing, or simply curious about recent neighborhood comps, Alyson is here to provide straightforward, expert guidance.
          </p>
        </div>

        <!-- Direct Contact Cards -->
        <div class="space-y-4 pt-2">
          <!-- Phone Card -->
          <div class="flex items-start gap-4 p-4 rounded-xl bg-stone-800/80 border border-stone-700">
            <div class="w-10 h-10 rounded-lg bg-amber-400/20 text-amber-300 flex items-center justify-center text-xl shrink-0">
              📞
            </div>
            <div>
              <span class="text-xs font-semibold text-stone-400 uppercase tracking-wider block">
                Direct Phone
              </span>
              <a
                href={`tel:${siteConfig.phone}`}
                class="text-lg font-bold text-white hover:text-amber-300 transition-colors"
              >
                {siteConfig.phoneDisplay}
              </a>
              <span class="text-xs text-stone-400 block mt-0.5">
                Available Mon–Sat 8:00 AM – 7:00 PM
              </span>
            </div>
          </div>

          <!-- Email Card -->
          <div class="flex items-start gap-4 p-4 rounded-xl bg-stone-800/80 border border-stone-700">
            <div class="w-10 h-10 rounded-lg bg-amber-400/20 text-amber-300 flex items-center justify-center text-xl shrink-0">
              ✉️
            </div>
            <div>
              <span class="text-xs font-semibold text-stone-400 uppercase tracking-wider block">
                Email Address
              </span>
              <span class="text-base font-bold text-white">
                {siteData.email}
              </span>
              <span class="text-xs text-stone-400 block mt-0.5">
                [Placeholder — Real email to be configured upon domain launch]
              </span>
            </div>
          </div>

          <!-- Canonical NAP Block -->
          <div class="p-5 rounded-xl bg-stone-800/80 border border-stone-700 text-stone-300 text-sm space-y-2">
            <span class="text-xs font-bold text-amber-300 uppercase tracking-wider block mb-1">
              Brokerage & Location Details
            </span>
            <p class="font-bold text-white text-base">
              {siteConfig.businessName}
            </p>
            <p class="text-stone-300">
              {siteConfig.address.locality}, {siteConfig.address.region} {siteConfig.address.postalCode}
            </p>
            <p class="text-xs text-stone-400 pt-2 border-t border-stone-700">
              Licensed Florida Real Estate Agent — License #{siteConfig.licenseNumber} · {siteConfig.brokerage}
            </p>
          </div>
        </div>
      </div>

      <!-- Right Column: Static / Non-functional Lead Form Shell -->
      <div class="lg:col-span-6 bg-white text-stone-900 rounded-2xl p-6 sm:p-8 shadow-2xl border border-stone-200">
        <div class="border-b border-stone-200 pb-4 mb-6">
          <span class="text-xs font-bold uppercase tracking-wider text-[#8A4700]">No-Obligation Consultation</span>
          <h3 class="font-serif text-2xl font-bold text-[#1b3a5c] mt-1">
            Send a Message or Request a Valuation
          </h3>
          <p class="text-xs sm:text-sm text-stone-600 mt-1">
            Fill out the form below and Alyson will reach out within 24 hours.
          </p>
        </div>

        {/* 
          NOTE: Form backend/submission needs to be wired to a real endpoint or serverless handler later;
          this is a static form shell. Do not fake a working submission.
        */}
        <form class="space-y-4" onsubmit="event.preventDefault();">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="contact-name" class="block text-xs font-bold text-stone-800 mb-1">
                Your Full Name <span class="text-amber-700">*</span>
              </label>
              <input
                type="text"
                id="contact-name"
                name="name"
                placeholder="John & Jane Doe"
                required
                class="w-full px-3 py-2.5 text-sm text-stone-900 border border-stone-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#1b3a5c]"
              />
            </div>
            <div>
              <label for="contact-phone" class="block text-xs font-bold text-stone-800 mb-1">
                Phone Number <span class="text-amber-700">*</span>
              </label>
              <input
                type="tel"
                id="contact-phone"
                name="phone"
                placeholder="(863) 555-0123"
                required
                class="w-full px-3 py-2.5 text-sm text-stone-900 border border-stone-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#1b3a5c]"
              />
            </div>
          </div>

          <div>
            <label for="contact-email" class="block text-xs font-bold text-stone-800 mb-1">
              Email Address <span class="text-amber-700">*</span>
            </label>
            <input
              type="email"
              id="contact-email"
              name="email"
              placeholder="youremail@example.com"
              required
              class="w-full px-3 py-2.5 text-sm text-stone-900 border border-stone-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#1b3a5c]"
            />
          </div>

          <div>
            <label for="contact-property" class="block text-xs font-bold text-stone-800 mb-1">
              Property Address / Neighborhood (Optional)
            </label>
            <input
              type="text"
              id="contact-property"
              name="propertyAddress"
              placeholder="e.g. 789 Deer Run Court, Sebring FL"
              class="w-full px-3 py-2.5 text-sm text-stone-900 border border-stone-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#1b3a5c]"
            />
          </div>

          <div>
            <label for="contact-message" class="block text-xs font-bold text-stone-800 mb-1">
              How Can Alyson Help You?
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="3"
              placeholder="I'm thinking about selling my Tanglewood home in the next 3 months..."
              class="w-full px-3 py-2.5 text-sm text-stone-900 border border-stone-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#1b3a5c]"
            ></textarea>
          </div>

          <!-- Notice explaining static state -->
          <p class="text-[11px] text-stone-500 italic">
            * Note: This contact form is currently in staging mode. For immediate assistance, please call <a href={`tel:${siteConfig.phone}`} class="font-bold text-[#1b3a5c] underline">{siteConfig.phoneDisplay}</a>.
          </p>

          <button
            type="submit"
            class="w-full py-3.5 px-4 rounded-md font-bold text-[#122944] hover:text-[#0b1726] shadow-sm transition-all cursor-pointer text-base bg-[#d4923a] hover:bg-[#b87a2e] min-h-[48px] text-center"
          >
            Submit Message →
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
