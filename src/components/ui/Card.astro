---
interface Props {
  as?: 'div' | 'article' | 'section';
  class?: string;
  padding?: 'none' | 'sm' | 'md' | 'lg';
  bordered?: boolean;
}

const {
  as: Component = 'div',
  class: className = '',
  padding = 'md',
  bordered = true,
} = Astro.props as Props;

const paddingStyles: Record<'none' | 'sm' | 'md' | 'lg', string> = {
  none: 'p-0',
  sm: 'p-4',
  md: 'p-6',
  lg: 'p-8',
};

const cardStyles = `bg-white rounded-xl shadow-sm ${bordered ? 'border border-[#ddd8d0]' : ''} ${paddingStyles[padding]} ${className}`;
---

<Component class={cardStyles}>
  <slot />
</Component>
