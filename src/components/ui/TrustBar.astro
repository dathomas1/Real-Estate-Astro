---
import { siteConfig } from '@data/site';
---

<div class="w-full py-4 px-4 bg-[#f0ebe1] border-y border-[#ddd8d0]">
  <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-center sm:justify-between gap-4 text-xs sm:text-sm font-semibold text-stone-800 text-center">
    <div class="flex items-center gap-2">
      <span class="text-[#8A4700] font-bold">✓</span>
      <span>Licensed Florida Real Estate Agent — License #{siteConfig.licenseNumber}</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="text-[#8A4700] font-bold">✓</span>
      <span>{siteConfig.brokerage} Affiliation</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="text-[#8A4700] font-bold">✓</span>
      <span>Sebring & Highlands County Specialist</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="text-[#8A4700] font-bold">✓</span>
      <span>Direct Agent Access (No Call Centers)</span>
    </div>
  </div>
</div>
