---
interface Props {
  label: string;
  name: string;
  type?: 'text' | 'email' | 'tel' | 'number' | 'textarea' | 'select';
  placeholder?: string;
  required?: boolean;
  helpText?: string;
  id?: string;
  options?: { label: string; value: string }[];
}

const {
  label,
  name,
  type = 'text',
  placeholder = '',
  required = false,
  helpText,
  id = name,
  options = [],
} = Astro.props;
---

<div class="mb-4 text-left">
  <label for={id} class="block text-sm font-bold text-gray-800 mb-1">
    {label}
    {required && <span class="text-red-600 font-bold ml-0.5" aria-hidden="true">*</span>}
  </label>

  {
    type === 'textarea' ? (
      <textarea
        id={id}
        name={name}
        placeholder={placeholder}
        required={required}
        rows="4"
        class="w-full px-4 py-3 text-base text-gray-900 bg-white border border-stone-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#d4923a] focus:border-transparent transition-all"
        aria-describedby={helpText ? `${id}-help` : undefined}
      />
    ) : type === 'select' ? (
      <select
        id={id}
        name={name}
        required={required}
        class="w-full px-4 py-3 text-base text-gray-900 bg-white border border-stone-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#d4923a] focus:border-transparent transition-all min-h-[48px]"
        aria-describedby={helpText ? `${id}-help` : undefined}
      >
        <option value="">Select an option...</option>
        {options.map((opt) => (
          <option value={opt.value}>{opt.label}</option>
        ))}
      </select>
    ) : (
      <input
        type={type}
        id={id}
        name={name}
        placeholder={placeholder}
        required={required}
        class="w-full px-4 py-3 text-base text-gray-900 bg-white border border-stone-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#d4923a] focus:border-transparent transition-all min-h-[48px]"
        aria-describedby={helpText ? `${id}-help` : undefined}
      />
    )
  }

  {helpText && (
    <p id={`${id}-help`} class="mt-1 text-xs text-gray-500">
      {helpText}
    </p>
  )}
</div>
