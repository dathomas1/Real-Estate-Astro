---
import { footerNav } from '@data/nav';
import { siteConfig } from '@data/site';

const currentYear = new Date().getFullYear();
---

<footer class="w-full bg-[#1b3a5c] text-stone-200 pt-16 pb-12 px-4 sm:px-6 border-t border-white/20">
  <div class="max-w-7xl mx-auto">
    <!-- Four Column Navigation Grid per Site Architecture Map -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-12">
      <!-- Column 1: Sebring Neighborhoods -->
      <div>
        <h2 class="font-serif text-lg font-bold text-white mb-4 border-b border-white/30 pb-2">
          Sebring Neighborhoods
        </h2>
        <ul class="space-y-2 text-sm list-none p-0 m-0">
          {
            footerNav.neighborhoods.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-stone-200 hover:text-amber-200 hover:underline underline-offset-2 transition-colors inline-block py-0.5"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Column 2: Seller Resources -->
      <div>
        <h2 class="font-serif text-lg font-bold text-white mb-4 border-b border-white/30 pb-2">
          Seller Resources
        </h2>
        <ul class="space-y-2 text-sm list-none p-0 m-0">
          {
            footerNav.sellerResources.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-stone-200 hover:text-amber-200 hover:underline underline-offset-2 transition-colors inline-block py-0.5"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Column 3: Service Areas -->
      <div>
        <h2 class="font-serif text-lg font-bold text-white mb-4 border-b border-white/30 pb-2">
          Service Areas
        </h2>
        <ul class="space-y-2 text-sm list-none p-0 m-0">
          {
            footerNav.serviceAreas.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-stone-200 hover:text-amber-200 hover:underline underline-offset-2 transition-colors inline-block py-0.5"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Column 4: Contact & Canonical NAP Block -->
      <div>
        <h2 class="font-serif text-lg font-bold text-white mb-4 border-b border-white/30 pb-2">
          Contact Alyson
        </h2>

        <!-- Exact Canonical NAP format: Alyson Thomas of Premier Plus Realty / Sebring, Florida 33872 / 7723428085 -->
        <address class="not-italic text-sm space-y-2 text-stone-200">
          <p class="font-bold text-white text-base leading-snug">
            {siteConfig.businessName}
          </p>
          <p>
            {siteConfig.address.locality}, {siteConfig.address.region} {siteConfig.address.postalCode}
          </p>
          <p class="pt-1">
            <a
              href={`tel:${siteConfig.phone}`}
              class="inline-block text-amber-300 hover:text-amber-200 font-bold text-base focus-visible:outline-white"
              aria-label={`Call ${siteConfig.phoneDisplay}`}
            >
              📞 {siteConfig.phone}
            </a>
          </p>

          <!-- License line per requirements: No REALTOR or NAR reference -->
          <p class="text-xs text-stone-300 pt-2 leading-relaxed">
            Licensed Florida Real Estate Agent — License #{siteConfig.licenseNumber} · {siteConfig.brokerage}
          </p>

          <!-- Directory Links: plain text links, NOT styled as badges -->
          <p class="text-xs text-stone-300 pt-1 leading-relaxed">
            Find me on:
            <a
              href={siteConfig.directoryLinks.realtorDotCom}
              class="underline hover:text-white transition-colors ml-1"
              rel="noopener noreferrer"
            >
              Realtor.com
            </a>
            <span aria-hidden="true" class="mx-1.5">·</span>
            <a
              href={siteConfig.directoryLinks.myStateMLS}
              class="underline hover:text-white transition-colors"
              rel="noopener noreferrer"
            >
              MyStateMLS
            </a>
          </p>
        </address>

        <div class="mt-4 pt-3 border-t border-white/20">
          <a
            href="/free-home-valuation/"
            class="inline-flex items-center justify-center w-full px-4 py-3 rounded-md font-bold text-[#122944] hover:text-[#0b1726] text-sm shadow-sm bg-[#d4923a] hover:bg-[#b87a2e] transition-all min-h-[48px]"
          >
            Free Home Valuation →
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Bar: Legal, EHO & Copyright -->
    <div class="pt-8 border-t border-white/20 text-xs text-stone-300 flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="flex items-center gap-3 flex-wrap justify-center sm:justify-start">
        <span>© {currentYear} {siteConfig.businessName}. All rights reserved.</span>
        <span aria-hidden="true" class="text-stone-400 hidden sm:inline">|</span>
        <span>Equal Housing Opportunity ⌂</span>
      </div>

      <ul class="flex items-center gap-4 list-none m-0 p-0 flex-wrap justify-center">
        {
          footerNav.legal.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-stone-300 hover:text-white underline underline-offset-2 transition-colors py-1 inline-block"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
